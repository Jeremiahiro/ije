# Password gate. Leave empty to make the site public.
# Checked on the server only — never prefix it with PUBLIC_ (that ships it to the browser).
SITE_GATE_PASSWORD=

# Bearer token for admin-only endpoints, e.g.
#   curl -X POST -H "Authorization: Bearer $ADMIN_SECRET" https://<site>/api/init-train-sheet
# Use a long random value (openssl rand -base64 32), different from the gate password.
ADMIN_SECRET=

# Google Sheets — service account credentials
# Use a NEW spreadsheet and service account per couple.
# Share the spreadsheet with the service account email (Editor access)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=        # "private_key" from the service account JSON — keep \n literals as-is

# /join page — wedding train & groomsmen (comma-separated)
# BOTH_NAMES: members who appear in both lists (avoids duplication)
BOTH_NAMES=
TRAIN_NAMES=
GROOMSMEN_NAMES=
