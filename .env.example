# Required for LaunchNotifyForm in the browser — must use PUBLIC_ so Vite/Astro inlines them.
# Copy to `.env`. Values: Supabase → Project settings → API (Project URL + anon public key).

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# RLS for table public."jj-interest" (hyphenated name must stay quoted in SQL).
# Run in Supabase → SQL editor. Inserts use the anon key from the browser.
#
# alter table public."jj-interest" enable row level security;
#
# create policy "jj_interest_anon_insert"
#   on public."jj-interest"
#   for insert
#   to anon
#   with check (true);
#
# Optional: do not add a SELECT policy for anon if you want emails private (dashboard/API still sees rows).
