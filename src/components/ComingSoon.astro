---
---

<div class="coming-soon">
	<div class="coming-soon__bg" aria-hidden="true"></div>
	<main class="coming-soon__main">
		<h1>Coming soon</h1>
	</main>
</div>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html.coming-soon-page,
	html.coming-soon-page body {
		margin: 0;
		height: 100%;
		overflow: hidden;
	}

	html.coming-soon-page body {
		font-family:
			system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			Helvetica,
			Arial,
			sans-serif;
	}
</style>

<style>
	.coming-soon {
		position: relative;
		isolation: isolate;
		min-height: 100dvh;
		height: 100dvh;
		width: 100%;
		max-width: 100vw;
		overflow: hidden;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 4vw, 2.5rem);
	}

	.coming-soon__bg {
		position: absolute;
		inset: clamp(-2rem, -8vw, -4rem);
		z-index: 0;
		background:
			radial-gradient(ellipse 80% 60% at 18% 22%, #c9a87c 0%, transparent 52%),
			radial-gradient(ellipse 70% 55% at 82% 78%, #a67c52 0%, transparent 48%),
			radial-gradient(ellipse 55% 45% at 50% 50%, #8b6914 0%, transparent 42%),
			linear-gradient(155deg, #2a1810 0%, #4a3728 38%, #1c120b 100%);
		filter: blur(clamp(18px, 4vw, 36px)) saturate(1.15);
		transform: scale(1.08);
	}

	.coming-soon::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: rgba(28, 18, 11, 0.52);
		pointer-events: none;
	}

	.coming-soon__main {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: min(100%, 28ch);
	}

	.coming-soon__main h1 {
		margin: 0;
		font-size: clamp(2.75rem, 10vw + 1rem, 6.5rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #fffcf7;
		text-shadow:
			0 0 28px rgba(255, 252, 247, 0.75),
			0 0 56px rgba(201, 168, 124, 0.45),
			0 0 88px rgba(166, 124, 82, 0.3);
	}

	@media (min-width: 768px) {
		.coming-soon__main {
			max-width: none;
		}

		.coming-soon__main h1 {
			white-space: nowrap;
		}
	}
</style>
