---
---

<div class="coming-soon">
	<div class="coming-soon__bg" aria-hidden="true"></div>
	<main class="coming-soon__main">
		<h1>Coming soon</h1>
	</main>
</div>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html.coming-soon-page,
	html.coming-soon-page body {
		margin: 0;
		height: 100%;
		overflow-x: hidden;
		margin-bottom: 400px;
	}

	html.coming-soon-page body {
		display: flex;
		flex-direction: column;
		font-family:
			system-ui,
			-apple-system,
			Segoe UI,
			Roboto,
			Helvetica,
			Arial,
			sans-serif;
		color: var(--text-primary);
		background: transparent;
	}
</style>

<style>
	.coming-soon {
		position: relative;
		isolation: isolate;
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
		max-width: 100vw;
		overflow: hidden;
		display: grid;
		place-items: center;
		padding: clamp(1rem, 4vw, 2.5rem);
	}

	.coming-soon__bg {
		position: absolute;
		inset: clamp(-2rem, -8vw, -4rem);
		z-index: 0;
		background:
			radial-gradient(ellipse 75% 60% at 22% 28%, rgba(201, 168, 124, 0.45), transparent 50%),
			radial-gradient(ellipse 70% 55% at 78% 72%, rgba(110, 82, 60, 0.18), transparent 48%),
			linear-gradient(155deg, #e8e5e0 0%, #e2ddd6 50%, #ebe7e1 100%);
		filter: blur(clamp(14px, 3.5vw, 28px)) saturate(1.05);
		transform: scale(1.06);
	}

	.coming-soon::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(180deg, rgb(255 252 247 / 0.28) 0%, rgb(233 231 228 / 0.15) 100%);
		pointer-events: none;
	}

	.coming-soon__main {
		position: relative;
		z-index: 2;
		text-align: center;
		max-width: min(100%, 28ch);
	}

	.coming-soon__main h1 {
		margin: 0;
		font-size: clamp(2.75rem, 10vw + 1rem, 6.5rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #6e523c;
		text-shadow:
			0 1px 0 rgb(255 255 255 / 0.6),
			0 12px 40px rgb(110 82 60 / 0.12);
	}

	@media (min-width: 768px) {
		.coming-soon__main {
			max-width: none;
		}

		.coming-soon__main h1 {
			white-space: nowrap;
		}
	}
</style>
