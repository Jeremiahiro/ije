---
export type ContentCardVariant = "default" | "primary" | "secondary";

interface Props {
	variant?: ContentCardVariant;
	as?: "article" | "div" | "section";
	class?: string;
}

const { variant = "default", as = "div", class: className } = Astro.props;

const Tag = as ?? "div";
---

<Tag class:list={["content-card", `content-card--${variant}`, className]}>
	<slot />
</Tag>

<style>
	.content-card {
		box-sizing: border-box;
		margin-block: clamp(1rem, 4vw, 2.75rem);
	}

	.content-card--default {
		border-radius: 1.5rem;
		border: 1px solid rgb(255 255 255 / 0.62);
		background: rgb(255 255 255 / 0.42);
		padding: 1.35rem 1.25rem;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.65),
			0 14px 40px rgb(110 82 60 / 0.09);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}

	.content-card--primary {
		border-radius: 1rem;
		border: 1px solid rgb(214 178 138 / 0.55);
		background: linear-gradient(
			135deg,
			rgb(255 251 243 / 0.95) 0%,
			rgb(245 232 214 / 0.88) 52%,
			rgb(255 246 236 / 0.92) 100%
		);
		padding: clamp(1.25rem, 3vw, 2rem);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.75);
	}

	.content-card--secondary {
		border-radius: clamp(1.75rem, 4vw, 2.25rem);
		border: 1px solid rgb(255 255 255 / 0.55);
		background: rgb(255 255 255 / 0.28);
		box-shadow: 0 22px 64px rgb(110 82 60 / 0.12);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
		padding: clamp(1.25rem, 4vw, 2.75rem);
	}

	@media (max-width: 899px) {
		.content-card--secondary {
			padding-block: clamp(1.05rem, 3.5vw, 2rem);
			padding-inline: clamp(0.8rem, 3.75vw, 1.65rem);
		}
	}

	@media (min-width: 768px) {
		.content-card--default {
			padding: 1.5rem;
		}
	}
</style>
