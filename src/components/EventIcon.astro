---
type EventIconType = "marriage" | "church" | "reception" | "party";

interface Props {
  type: EventIconType;
  class?: string;
}

const { type, class: className } = Astro.props;

const svgAttrs = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
} as const;
---

{
  type === "marriage" && (
    <svg class={className} {...svgAttrs}>
      {/* Palm-wine cup (Ịgba Nkwụ) */}
      <path d="M6 4h12" />
      <path d="M7 4c0 4.2 1.2 7 5 7s5-2.8 5-7" />
      <path d="M12 11v7" />
      <path d="M8.5 18h7" />
    </svg>
  )
}
{
  type === "church" && (
    <svg class={className} {...svgAttrs}>
      <path d="M12 2v3.6" />
      <path d="M10.2 3.6h3.6" />
      <path d="M6 21V10l6-4 6 4v11" />
      <path d="M9.5 21v-4.5a2.5 2.5 0 0 1 5 0V21" />
      <path d="M3.5 21h17" />
    </svg>
  )
}
{
  type === "reception" && (
    <svg class={className} {...svgAttrs}>
      {/* Two flutes — a toast */}
      <path d="M8.6 3.5h3l-.5 7a1 1 0 0 1-2 0l-.5-7Z" />
      <path d="M10.1 10.5V18" />
      <path d="M8.4 18h3.4" />
      <path d="M13 3.5h3l-.5 7a1 1 0 0 1-2 0l-.5-7Z" />
      <path d="M14.5 10.5V18" />
      <path d="M12.8 18h3.4" />
    </svg>
  )
}
{
  type === "party" && (
    <svg class={className} {...svgAttrs}>
      {/* Beamed music notes */}
      <path d="M9 17V5l10-2v10" />
      <circle cx="6.6" cy="17" r="2.4" />
      <circle cx="16.6" cy="15" r="2.4" />
    </svg>
  )
}
