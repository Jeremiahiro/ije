---
import { navItems, siteTitleSuffix } from "@/data/site-nav";

const year = 2027;
const brandMiddle = siteTitleSuffix.slice(1);
const footerNavLinks = navItems.filter((n) => n.target === "_self")
---

<footer class="site-footer" aria-label="Site">
  <div class="site-footer__inner">
    <nav class="site-footer__nav" aria-label="Footer navigation">
      {
        footerNavLinks.map((link) => (
          <a class="site-footer__nav-link" href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="site-footer__brand" aria-label={siteTitleSuffix}>
      <span class="site-footer__brand-stage">
        <span class="site-footer__brand-row">
          <span class="site-footer__brand-lead">J</span>
          <span
            class="site-footer__brand-segment site-footer__brand-segment--full"
            >{brandMiddle}</span
          >
          <span
            class="site-footer__brand-segment site-footer__brand-segment--initials"
            aria-hidden="true"
          >
            &#x2665;&#xFE0E;J
          </span>
        </span>
      </span>
    </p>

    <p class="site-footer__countdown" aria-live="polite"></p>

    <p class="site-footer__meta">&copy; {year} · With love</p>
  </div>
</footer>

<style>
  .site-footer {
    --footer-tan: #e8d5b8;
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 0;
    height: var(--site-footer-reveal);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 2rem 1.5rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
    color: var(--footer-tan);
    /* background-color: #1c120a; */
    background-image:
      linear-gradient(
        to bottom,
        rgb(18 10 4 / 0.18) 0%,
        rgb(18 10 4 / 0.38) 55%,
        rgb(18 10 4 / 0.62) 100%
      ),
      url("/assets/for-footer.webp");
    background-size: cover;
    background-position: top center;
    background-repeat: no-repeat;
    box-shadow: 0 -20px 60px -8px rgb(18 10 4 / 0.35);
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: min(100%, 60rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* Nav */

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.1rem 1.5rem;
    margin-bottom: clamp(1.5rem, 4vh, 2.5rem);
  }

  .site-footer__nav-link {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(232 213 184 / 0.65);
    text-decoration: none;
    transition: color 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__nav-link:hover {
      color: rgb(232 213 184 / 1);
    }
  }

  /* Brand */

  .site-footer__brand {
    display: flex;
    justify-content: center;
    width: 100%;
    margin: 0;
    padding-inline: 0.75rem;
    text-align: center;
  }

  .site-footer__brand-stage {
    --brand-cycle: 6s;
    --brand-stage-width: 20rem;
    --brand-full-width: 18rem;
    --brand-initials-width: 4rem;
    position: relative;
    display: block;
    width: var(--brand-stage-width);
    max-width: 100%;
    height: 1.2em;
    font-family: var(--font-heading);
    font-size: clamp(3rem, 8vw, 6.5rem);
    line-height: 1.2;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .site-footer__brand-row {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .site-footer__brand-segment {
    overflow: hidden;
    max-width: 0;
    animation-duration: var(--brand-cycle);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  .site-footer__brand-segment--full {
    animation-name: site-footer-brand-full;
  }

  .site-footer__brand-segment--initials {
    animation-name: site-footer-brand-initials;
  }

  @keyframes site-footer-brand-full {
    0%,
    22%,
    78%,
    100% {
      max-width: var(--brand-full-width);
    }
    34%,
    66% {
      max-width: 0;
    }
  }

  @keyframes site-footer-brand-initials {
    0%,
    22%,
    78%,
    100% {
      max-width: 0;
    }
    34%,
    66% {
      max-width: var(--brand-initials-width);
    }
  }

  /* Countdown */

  .site-footer__countdown {
    margin: clamp(0.65rem, 2vh, 1rem) 0 0;
    font-size: clamp(0.72rem, 1.8vw, 0.9rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: rgb(232 213 184 / 0.65);
    text-align: center;
    min-height: 1.4em;
  }

  /* Meta */

  .site-footer__meta {
    margin: clamp(1.25rem, 3vh, 2rem) 0 0;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: rgb(232 213 184 / 0.4);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__brand-segment--full {
      max-width: var(--brand-full-width);
      animation: none;
    }

    .site-footer__brand-segment--initials {
      display: none;
    }
  }
</style>

<script>
  function measureUnclippedWidth(el: HTMLElement) {
    const previousAnimation = el.style.animation;
    const previousMaxWidth = el.style.maxWidth;
    el.style.animation = "none";
    el.style.maxWidth = "none";
    const width = Math.ceil(el.getBoundingClientRect().width);
    el.style.maxWidth = previousMaxWidth;
    el.style.animation = previousAnimation;
    return width;
  }

  function measureBrandStage(stage: HTMLElement) {
    const lead = stage.querySelector(".site-footer__brand-lead");
    const full = stage.querySelector(".site-footer__brand-segment--full");
    const initials = stage.querySelector(
      ".site-footer__brand-segment--initials",
    );
    if (
      !(lead instanceof HTMLElement) ||
      !(full instanceof HTMLElement) ||
      !(initials instanceof HTMLElement)
    ) {
      return;
    }

    const leadWidth = measureUnclippedWidth(lead);
    const fullWidth = measureUnclippedWidth(full);
    const initialsWidth = measureUnclippedWidth(initials);

    stage.style.setProperty("--brand-full-width", `${fullWidth}px`);
    stage.style.setProperty("--brand-initials-width", `${initialsWidth}px`);
    stage.style.setProperty(
      "--brand-stage-width",
      `${Math.ceil(leadWidth + Math.max(fullWidth, initialsWidth))}px`,
    );
  }

  function updateCountdown(el: HTMLElement) {
    const wedding = new Date("2027-01-04T10:00:00+01:00");
    const now = new Date();
    const msLeft = wedding.getTime() - now.getTime();
    const days = Math.max(0, Math.ceil(msLeft / 86400000));

    if (days === 0) {
      el.textContent = "Today · January 4, 2027";
    } else if (days === 1) {
      el.textContent = "Tomorrow · January 4, 2027";
    } else {
      el.textContent = `${days.toLocaleString()} days · January 4, 2027`;
    }
  }

  function initFooter() {
    const footer = document.querySelector(".site-footer");
    const shell = document.querySelector(".site-shell");
    if (!(footer instanceof HTMLElement) || !(shell instanceof HTMLElement))
      return;

    const inner = footer.querySelector<HTMLElement>(".site-footer__inner");
    const stage = footer.querySelector<HTMLElement>(
      ".site-footer__brand-stage",
    );
    const countdown = footer.querySelector<HTMLElement>(
      ".site-footer__countdown",
    );

    if (!inner || !stage) return;

    let revealed = false;
    let resizeFrame = 0;

    const queueMeasure = () => {
      cancelAnimationFrame(resizeFrame);
      resizeFrame = requestAnimationFrame(() => {
        measureBrandStage(stage);
      });
    };

    const updateReveal = () => {
      const shellBottom = shell.getBoundingClientRect().bottom;
      const innerTop = window.innerHeight - inner.offsetHeight;
      const isRevealed = shellBottom <= innerTop + 40;
      if (isRevealed === revealed) return;
      revealed = isRevealed;
      inner.classList.toggle("site-footer__inner--revealed", revealed);
    };

    const onResize = () => {
      queueMeasure();
      updateReveal();
    };

    if (countdown) updateCountdown(countdown);

    void document.fonts.ready.then(queueMeasure);
    queueMeasure();
    updateReveal();

    window.addEventListener("scroll", updateReveal, { passive: true });
    window.addEventListener("resize", onResize, { passive: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFooter, { once: true });
  } else {
    initFooter();
  }
</script>
