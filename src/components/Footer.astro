---
import { navItems, siteTitleSuffix } from "@/data/site-nav";

const year = new Date().getFullYear();
const topLinks = navItems.map((item) =>
	item.kind === "link"
		? { href: item.href, label: item.label }
		: { href: item.path, label: item.label },
);
---

<footer class="site-footer" aria-label="Site">
	<div class="site-footer__inner">
		<p class="site-footer__brand">{siteTitleSuffix}</p>
		<nav class="site-footer__nav" aria-label="Footer">
			<ul class="site-footer__list">
				<li>
					<a href="/" class="site-footer__link">Home</a>
				</li>
				{
					topLinks.map(({ href, label }) => (
						<li>
							<a href={href} class="site-footer__link">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="site-footer__meta">&copy; {year} · With love</p>
	</div>
</footer>

<style>
	.site-footer {
		--footer-tan: #6e523c;
		position: fixed;
		z-index: 0;
		left: 0;
		right: 0;
		bottom: 0;
		min-height: var(--site-footer-reveal);
		padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		color: var(--footer-tan);
		background-color: rgb(233 231 228);
		background-image:
			linear-gradient(
				180deg,
				rgb(255 252 247 / 0.82) 0%,
				rgb(233 228 220 / 0.75) 42%,
				rgb(220 212 202 / 0.7) 100%
			),
			url("/assets/for-footer.jpeg");
		background-size: cover;
		background-position: center, top;
		background-repeat: no-repeat, no-repeat;
		border-top: 1px solid rgb(110 82 60 / 0.18);
		box-shadow: 0 -8px 32px rgb(110 82 60 / 0.08);
		pointer-events: auto;
	}

	.site-footer__inner {
		width: 100%;
		max-width: 36rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		text-align: center;
	}

	.site-footer__brand {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.site-footer__nav {
		width: 100%;
	}

	.site-footer__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.75rem;
		justify-content: center;
	}

	.site-footer__link {
		display: inline-block;
		padding: 0.25rem 0.4rem;
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		color: inherit;
		border-radius: 9999px;
		border: 1px solid transparent;
		opacity: 0.92;
		transition:
			background-color 180ms ease,
			border-color 180ms ease,
			opacity 180ms ease;
	}

	.site-footer__link:hover {
		background: rgb(255 255 255 / 0.45);
		border-color: rgb(110 82 60 / 0.2);
		opacity: 1;
	}

	.site-footer__meta {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 500;
		color: rgb(110 82 60 / 0.72);
	}
</style>
