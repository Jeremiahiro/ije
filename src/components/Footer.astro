---
import { siteTitleSuffix } from "@/data/site-nav";

const year = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site">
	<div class="site-footer__inner">
		<p class="site-footer__brand">
			<span class="site-footer__brand-breathe">{siteTitleSuffix}</span>
		</p>
		<div class="site-footer__lower">
			<p class="site-footer__meta">&copy; {year} · With love</p>
		</div>
	</div>
</footer>

<style>
	@font-face {
		font-family: "TFMix VF";
		src: url("https://garet.typeforward.com/assets/fonts/shared/TFMixVF.woff2") format("woff2");
		font-weight: 100 900;
		font-style: normal;
		font-display: swap;
	}

	.site-footer {
		--footer-tan: #6e523c;
		position: fixed;
		z-index: 0;
		left: 0;
		right: 0;
		bottom: 0;
		min-height: var(--site-footer-reveal);
		padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
		display: flex;
		flex-direction: column;
		align-items: center;
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		color: var(--footer-tan);
		background-color: rgb(233 231 228);
		background-image:
			linear-gradient(
				180deg,
				rgb(255 252 247 / 0.82) 0%,
				rgb(233 228 220 / 0.75) 42%,
				rgb(220 212 202 / 0.7) 100%
			),
			url("/assets/for-footer.jpeg");
		background-size: cover;
		background-position: center, top;
		background-repeat: no-repeat, no-repeat;
		border-top: none;
		box-shadow: 0 -12px 40px -8px rgb(110 82 60 / 0.12);
		pointer-events: auto;
	}

	.site-footer__inner {
		position: relative;
		z-index: 1;
		flex: 1 1 auto;
		width: 100%;
		max-width: 36rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 0;
		text-align: center;
	}

	.site-footer__inner::before {
		content: "";
		flex: 1 1 auto;
		min-height: 0;
		width: 100%;
	}

	.site-footer__lower {
		flex: 0 0 auto;
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
	}

	.site-footer__brand {
		position: absolute;
		inset-inline: 0;
		top: 50%;
		z-index: 1;
		display: flex;
		justify-content: center;
		align-items: center;
		margin: 0;
		text-align: center;
		transform: translateY(-50%);
	}

	.site-footer__brand-breathe {
		font-family: "TFMix VF", ui-sans-serif, system-ui, sans-serif;
		font-size: clamp(1.75rem, 11vw, 4rem);
		font-weight: 400;
		color: var(--footer-tan);
		text-align: center;
		text-shadow:
			0 1px 0 rgb(255 255 255 / 0.45),
			0 2px 8px rgb(110 82 60 / 0.2);
		font-variation-settings: "wght" 100;
		animation: site-footer-letter-breathe 3s ease-in-out infinite;
		white-space: normal;
	}

	@media (min-width: 768px) {
		.site-footer__brand-breathe {
			white-space: nowrap;
		}
	}

	@keyframes site-footer-letter-breathe {
		from,
		to {
			font-variation-settings: "wght" 100;
		}
		50% {
			font-variation-settings: "wght" 900;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-footer__brand-breathe {
			animation: none;
			font-variation-settings: "wght" 500;
		}
	}

	.site-footer__meta {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 500;
		color: rgb(110 82 60 / 0.72);
	}
</style>
