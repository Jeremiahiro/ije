---
import { navHref, navItems, type NavEntry } from "@/data/site-nav";

const brandAlt = "J & J";
const logoSrc = "/assets/logo-n.png";
const cta = { href: "/rsvp", label: "RSVP" } as const;

const navSublinkPanels = navItems.filter(
	(item): item is Extract<NavEntry, { kind: "sublinks" }> => item.kind === "sublinks",
);

const pathname = Astro.url.pathname;
const isCurrent = (href: string): boolean => {
	if (href.startsWith("#")) return false;
	const base = href.replace(/\/+$/, "") || "/";
	if (base === "/") return pathname === "/";
	return pathname === base || pathname.startsWith(`${base}/`);
};
---

<div class="app-header" data-app-header>
	<div class="app-header__bar">
		<div class="app-header__bar-inner">
			<div class="app-header__idle">
				<a href="/" class="app-header__logo">
					<img class="app-header__logo-img" src={logoSrc} alt={brandAlt} width="500" height="80" decoding="async" />
				</a>

				<div class="app-header__idle-actions">
					<a class="app-header__cta" href={cta.href}>{cta.label}</a>
					<button
						type="button"
						class="app-header__menu"
						id="app-header-menu-open"
						aria-expanded="false"
						aria-controls="app-header-menu-stack"
						aria-label="Open menu"
					>
						<span class="app-header__burger" aria-hidden="true">
							<span class="app-header__burger-line"></span>
							<span class="app-header__burger-line"></span>
						</span>
					</button>
				</div>
			</div>

			<div class="app-header__menu-stack" id="app-header-menu-stack" tabindex="-1">
			<div class="app-header__menu-panel" id="app-header-menu-panel">
				<nav class="app-header__nav" aria-label="Site">
					<div class="app-header__nav-track" data-app-header-nav-track>
						<span class="app-header__nav-highlight" aria-hidden="true"></span>
						<ul class="app-header__nav-list">
							{
								navItems.map((item) =>
									item.kind === "sublinks" ? (
										<li class="app-header__nav-item">
											<button
												type="button"
												class:list={[
													"app-header__nav-link",
													"app-header__nav-link--disclosure",
													{ "app-header__nav-link--active": isCurrent(item.path) },
												]}
												id={`app-header-nav-trigger-${item.id}`}
												data-nav-sublinks-trigger={item.id}
												aria-expanded="false"
												aria-controls={`app-header-sublinks-${item.id}`}
												aria-haspopup="true"
											>
												{item.label}
												<span class="app-header__disclosure-chevron" aria-hidden="true"></span>
											</button>
										</li>
									) : (
										<li class="app-header__nav-item">
											<a
												class:list={[
													"app-header__nav-link",
													{ "app-header__nav-link--active": isCurrent(item.href) },
												]}
												href={item.href}
											>
												{item.label}
											</a>
										</li>
									),
								)
							}
						</ul>
					</div>
				</nav>
				<button type="button" class="app-header__close" id="app-header-menu-close" aria-label="Close menu">
					<span class="app-header__close-icon" aria-hidden="true"></span>
				</button>
			</div>
			{
				navSublinkPanels.map((panel) => (
					<div
						class="app-header__nav-sublinks"
						data-nav-sublinks-panel={panel.id}
						id={`app-header-sublinks-${panel.id}`}
						role="region"
						aria-labelledby={`app-header-nav-trigger-${panel.id}`}
					>
						<div class="app-header__nav-sublinks-clip">
							<div class="app-header__nav-sublinks-motion">
								<ul class="app-header__nav-sublinks-list">
									{panel.sublinks.map(({ slug, title, description, image }) => (
										<li>
											<a
												class:list={[
													"app-header__nav-sublinks-row",
													{ "app-header__nav-sublinks-row--no-thumb": !image },
												]}
												href={navHref(panel.path, slug)}
											>
												{image ? (
													<img
														class="app-header__nav-sublinks-thumb"
														src={image}
														alt=""
														width="52"
														height="52"
														loading="lazy"
														decoding="async"
													/>
												) : null}
												<span class="app-header__nav-sublinks-copy">
													<span class="app-header__nav-sublinks-title">{title}</span>
													{description ? (
														<span class="app-header__nav-sublinks-desc">{description}</span>
													) : null}
												</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					</div>
				))
			}
			</div>
		</div>
	</div>
</div>

<script>
	import { mountAppHeaderNavHighlight } from "@/components/AppHeaderNav.script";

	mountAppHeaderNavHighlight();
</script>

<script is:inline>
	(() => {
		const root = document.querySelector("[data-app-header]");
		if (!(root instanceof HTMLElement)) return;

		let scrollRaf = false;
		const onScroll = () => {
			if (scrollRaf) return;
			scrollRaf = true;
			requestAnimationFrame(() => {
				scrollRaf = false;
				if (root.dataset.menuOpen === "true" && !matchMedia("(min-width: 1024px)").matches) return;
				const y = window.scrollY || document.documentElement.scrollTop;
				const on = root.dataset.scrolled === "true";
				if (!on && y > 20) root.dataset.scrolled = "true";
				else if (on && y < 6) delete root.dataset.scrolled;
			});
		};
		onScroll();
		window.addEventListener("scroll", onScroll, { passive: true });

		const openBtn = root.querySelector("#app-header-menu-open");
		const closeBtn = root.querySelector("#app-header-menu-close");
		const stack = root.querySelector("#app-header-menu-stack");
		const triggers = root.querySelectorAll("[data-nav-sublinks-trigger]");
		const panels = root.querySelectorAll("[data-nav-sublinks-panel]");
		if (!openBtn || !closeBtn) return;

		const mqDesktop = matchMedia("(min-width: 1024px)");
		const isDesktop = () => mqDesktop.matches;

		const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
		const useSublinksHover = () => matchMedia("(hover: hover) and (pointer: fine)").matches;
		const prefersCoarsePointer = () => matchMedia("(hover: none) and (pointer: coarse)").matches;

		let subCloseT = 0;
		const cancelSubClose = () => {
			if (subCloseT) clearTimeout(subCloseT);
			subCloseT = 0;
		};
		const scheduleSubClose = () => {
			cancelSubClose();
			subCloseT = window.setTimeout(() => {
				subCloseT = 0;
				const a = document.activeElement;
				if (a instanceof Element && root.contains(a) && sublinksId(a)) return;
				setSublinks(null);
			}, 160);
		};

		function sublinksId(el) {
			if (!(el instanceof Element)) return null;
			const t = el.closest("[data-nav-sublinks-trigger]");
			if (t) return t.getAttribute("data-nav-sublinks-trigger");
			const p = el.closest("[data-nav-sublinks-panel]");
			return p ? p.getAttribute("data-nav-sublinks-panel") : null;
		}

		function setSublinks(id) {
			cancelSubClose();
			if (!id) {
				delete root.dataset.navSublinksOpen;
				triggers.forEach((b) => b.setAttribute("aria-expanded", "false"));
				panels.forEach((p) => p.removeAttribute("data-open"));
				return;
			}
			root.dataset.navSublinksOpen = id;
			triggers.forEach((b) => {
				b.setAttribute("aria-expanded", b.getAttribute("data-nav-sublinks-trigger") === id ? "true" : "false");
			});
			panels.forEach((p) => {
				const pid = p.getAttribute("data-nav-sublinks-panel");
				pid === id ? p.setAttribute("data-open", "true") : p.removeAttribute("data-open");
			});
		}

		function setMenuAria(open) {
			openBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		}

		function finishMenuClose() {
			if (stack instanceof HTMLElement) stack.classList.add("app-header__menu-stack--jump");
			delete root.dataset.menuOpen;
			delete root.dataset.menuExit;
			delete root.dataset.navSublinksOpen;
			triggers.forEach((b) => b.setAttribute("aria-expanded", "false"));
			panels.forEach((p) => p.removeAttribute("data-open"));
			openBtn.setAttribute("aria-expanded", "false");
			setMenuAria(false);
			if (stack instanceof HTMLElement) {
				stack.setAttribute("inert", "");
				stack.setAttribute("aria-hidden", "true");
			}
			if (openBtn instanceof HTMLElement) openBtn.focus();
			onScroll();
			requestAnimationFrame(() => {
				if (stack instanceof HTMLElement) stack.classList.remove("app-header__menu-stack--jump");
			});
		}

		function setMenuOpen(open) {
			if (!open && isDesktop()) return;
			if (open) {
				delete root.dataset.menuExit;
				setSublinks(null);
				if (stack instanceof HTMLElement) stack.classList.remove("app-header__menu-stack--jump");
				root.dataset.menuOpen = "true";
				openBtn.setAttribute("aria-expanded", "true");
				setMenuAria(true);
				if (stack instanceof HTMLElement) {
					stack.removeAttribute("inert");
					stack.setAttribute("aria-hidden", "false");
				}
				requestAnimationFrame(() => {
					if (isDesktop()) return;
					if (stack instanceof HTMLElement && prefersCoarsePointer()) stack.focus({ preventScroll: true });
					else if (closeBtn instanceof HTMLElement) closeBtn.focus();
				});
			} else {
				if (root.dataset.menuOpen !== "true") return;
				if (root.dataset.menuExit === "true") return;
				openBtn.setAttribute("aria-expanded", "false");
				setMenuAria(false);
				if (reducedMotion) {
					finishMenuClose();
					return;
				}
				root.dataset.menuExit = "true";
			}
		}

		if (stack instanceof HTMLElement) {
			stack.setAttribute("inert", "");
			stack.setAttribute("aria-hidden", "true");
			stack.addEventListener("transitionend", (e) => {
				if (e.propertyName !== "transform" || e.target !== stack || root.dataset.menuExit !== "true") return;
				finishMenuClose();
			});
			stack.addEventListener(
				"pointerdown",
				(e) => {
					if (!(e.target instanceof Element)) return;
					if (e.target.closest("[data-nav-sublinks-trigger]")) {
						cancelSubClose();
						return;
					}
					const panel = e.target.closest("[data-nav-sublinks-panel]");
					if (!panel) return;
					cancelSubClose();
					const sid = panel.getAttribute("data-nav-sublinks-panel");
					if (sid) setSublinks(sid);
				},
				true,
			);
		}

		openBtn.addEventListener("click", () => {
			if (isDesktop()) return;
			setMenuOpen(root.dataset.menuOpen !== "true");
		});
		closeBtn.addEventListener("click", () => setMenuOpen(false));

		root.addEventListener("click", (e) => {
			if (!(e.target instanceof Element)) return;
			if (isDesktop()) return;
			if (e.target.closest("#app-header-menu-stack a[href]")) setMenuOpen(false);
		});

		triggers.forEach((btn) => {
			const id = btn.getAttribute("data-nav-sublinks-trigger");
			if (!id) return;
			btn.addEventListener(
				"mousedown",
				(e) => {
					if (e.button !== 0) return;
					btn.dataset.preSublinksOpen = root.dataset.navSublinksOpen ?? "";
				},
				true,
			);
			btn.addEventListener("click", (e) => {
				e.stopPropagation();
				const pre = btn.dataset.preSublinksOpen;
				delete btn.dataset.preSublinksOpen;
				if (pre === undefined) {
					setSublinks(root.dataset.navSublinksOpen === id ? null : id);
					return;
				}
				if (pre === id) setSublinks(null);
				else setSublinks(id);
			});
			btn.addEventListener("mouseenter", () => useSublinksHover() && setSublinks(id));
			btn.addEventListener("mouseleave", () => useSublinksHover() && scheduleSubClose());
		});

		panels.forEach((panel) => {
			const id = panel.getAttribute("data-nav-sublinks-panel");
			if (!id) return;
			panel.addEventListener("mouseenter", () => useSublinksHover() && setSublinks(id));
			panel.addEventListener("mouseleave", () => useSublinksHover() && scheduleSubClose());
		});

		root.addEventListener("focusin", (e) => {
			if (root.dataset.menuOpen !== "true") return;
			const target = e.target instanceof Element ? e.target : null;
			if (!target) return;
			const triggerEl = target.closest("[data-nav-sublinks-trigger]");
			if (triggerEl) {
				const tid = triggerEl.getAttribute("data-nav-sublinks-trigger");
				if (!tid) return;
				const rel = e.relatedTarget;
				if (rel instanceof Element) {
					const prevT = rel.closest("[data-nav-sublinks-trigger]");
					if (prevT && prevT !== triggerEl) setSublinks(tid);
					else if (rel.closest("[data-nav-sublinks-panel]")) setSublinks(tid);
				}
				return;
			}
			const id = sublinksId(target);
			if (id) setSublinks(id);
		});
		root.addEventListener("focusout", () => {
			if (root.dataset.menuOpen !== "true") return;
			requestAnimationFrame(() => {
				const a = document.activeElement;
				if (!(a instanceof Node) || !root.contains(a)) {
					setSublinks(null);
					return;
				}
				if (a instanceof Element && a.closest("[data-nav-sublinks-trigger]")) return;
				const id = sublinksId(a);
				setSublinks(id);
			});
		});

		document.addEventListener(
			"click",
			(e) => {
				if (!root.dataset.navSublinksOpen) return;
				const t = e.target;
				if (!(t instanceof Node) || (stack instanceof HTMLElement && stack.contains(t))) return;
				setSublinks(null);
			},
			true,
		);

		window.addEventListener("keydown", (e) => {
			if (e.key !== "Escape" || root.dataset.menuOpen !== "true") return;
			e.preventDefault();
			if (root.dataset.navSublinksOpen) setSublinks(null);
			else if (!isDesktop()) setMenuOpen(false);
		});

		function applyLayoutMode() {
			if (!(stack instanceof HTMLElement)) return;
			if (isDesktop()) {
				stack.classList.remove("app-header__menu-stack--jump");
				delete root.dataset.menuExit;
				root.dataset.menuOpen = "true";
				openBtn.setAttribute("aria-expanded", "true");
				setMenuAria(true);
				openBtn.setAttribute("aria-hidden", "true");
				openBtn.setAttribute("tabindex", "-1");
				closeBtn.setAttribute("aria-hidden", "true");
				closeBtn.setAttribute("tabindex", "-1");
				stack.removeAttribute("inert");
				stack.setAttribute("aria-hidden", "false");
			} else {
				openBtn.removeAttribute("aria-hidden");
				openBtn.removeAttribute("tabindex");
				closeBtn.removeAttribute("aria-hidden");
				closeBtn.removeAttribute("tabindex");
				if (root.dataset.menuOpen === "true") finishMenuClose();
			}
		}

		applyLayoutMode();
		mqDesktop.addEventListener("change", applyLayoutMode);
	})();
</script>

<style>
	@reference "tailwindcss";

	.app-header {
		--header-tan: #6e523c;
		--header-glass-bg: rgb(255 255 255 / 0.38);
		--header-glass-hover-bg: rgb(255 255 255 / 0.48);
		--header-glass-border: rgb(255 255 255 / 0.55);
		--header-glass-active-bg: rgb(255 255 255 / 0.58);
		--header-glass-active-border: rgb(255 255 255 / 0.72);
		--header-glass-active-blur: 12px;
		--header-glass-blur: 14px;
		--header-transition-duration: 420ms;
		--header-transition-ease: cubic-bezier(0.4, 0, 0.2, 1);
		--header-idle-glass-duration: 520ms;
		--header-idle-glass-ease: cubic-bezier(0.4, 0, 0.2, 1);
		--header-menu-slide-duration: 560ms;
		--header-panel-ease: cubic-bezier(0.34, 1.56, 0.64, 1);
		--header-menu-stack-ease: cubic-bezier(0.34, 1.56, 0.64, 1);
		--header-menu-stack-duration: var(--header-menu-slide-duration);
		--header-menu-radius: 40px;
		--header-menu-stack-hide-y: calc(-100% - 1rem);
		--header-idle-split-duration: var(--header-menu-stack-duration);
		--header-idle-split-ease: var(--header-menu-stack-ease);

		@apply absolute inset-x-0 top-0 z-50 w-full bg-transparent;
		padding-top: max(1rem, env(safe-area-inset-top, 0px));
		font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
		-webkit-text-size-adjust: 100%;
		text-size-adjust: 100%;
	}

	.app-header[data-scrolled]:not([data-menu-open="true"]) {
		@apply fixed inset-x-0 top-0;
	}

	.app-header[data-menu-open="true"] {
		@apply fixed inset-x-0 top-0;
	}

	.app-header__bar {
		@apply relative mx-auto w-full min-h-[var(--site-header-height)];
		transition:
			background-color var(--header-transition-duration) var(--header-transition-ease),
			border-color var(--header-transition-duration) var(--header-transition-ease),
			box-shadow var(--header-transition-duration) var(--header-transition-ease),
			backdrop-filter var(--header-transition-duration) var(--header-transition-ease),
			-webkit-backdrop-filter var(--header-transition-duration) var(--header-transition-ease),
			border-radius var(--header-transition-duration) var(--header-transition-ease);
	}

	.app-header__bar-inner {
		@apply relative mx-auto grid w-full min-h-[var(--site-header-height)] items-start px-4 sm:px-6 xl:px-70;
		grid-template-areas: "stack";
	}

	.app-header[data-menu-open="true"] .app-header__bar-inner {
		@apply mx-auto w-fit max-w-full py-0;
		min-height: var(--site-header-height);
		overflow-x: visible;
		border: none;
		background: transparent;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		box-shadow: none;
		border-radius: 0;
		transition: none;
	}

	@media (max-width: 1023px) {
		.app-header__cta {
			display: none;
		}
	}

	@media (min-width: 1024px) {
		.app-header {
			--header-menu-stack-ease: cubic-bezier(0.175, 0.885, 0.32, 1.275);
			--header-menu-stack-duration: 640ms;
		}

		.app-header[data-menu-open="true"] {
			overflow: visible;
		}

		.app-header[data-menu-open="true"] .app-header__bar-inner {
			@apply w-full;
			justify-items: center;
			align-items: center;
			overflow: visible;
		}

		.app-header[data-menu-open="true"] .app-header__idle {
			min-height: var(--site-header-height);
		}

		.app-header[data-menu-open="true"] .app-header__menu-stack {
			@apply w-fit max-w-full min-w-0;
			min-height: var(--site-header-height);
			justify-content: center;
			transform: translateY(0) !important;
			pointer-events: auto;
			z-index: 3;
		}

		.app-header__menu,
		.app-header__close {
			display: none !important;
		}

		.app-header__menu-stack.app-header__menu-stack--jump {
			transform: translateY(0) !important;
		}
	}

	.app-header__idle {
		grid-area: stack;
		position: absolute;
		inset-inline: 0;
		top: 0;
		width: 100%;
		height: fit-content;
		z-index: 2;
		@apply flex items-center justify-between gap-4;
	}

	.app-header[data-menu-open="true"] .app-header__idle {
		pointer-events: none;
		z-index: 4;
	}

	.app-header[data-menu-open="true"] .app-header__idle .app-header__logo,
	.app-header[data-menu-open="true"] .app-header__idle .app-header__cta,
	.app-header[data-menu-open="true"] .app-header__idle .app-header__menu {
		pointer-events: auto;
	}

	.app-header__idle-actions {
		@apply flex shrink-0 items-center gap-2 sm:gap-3;
		backface-visibility: hidden;
		transition:
			transform var(--header-idle-split-duration) var(--header-idle-split-ease);
	}

	.app-header:not([data-menu-open="true"]) .app-header__idle .app-header__logo,
	.app-header[data-menu-open="true"][data-menu-exit="true"] .app-header__idle .app-header__logo {
		@starting-style {
			transform: translateX(-100%);
		}
		transform: translateX(0);
	}

	.app-header:not([data-menu-open="true"]) .app-header__idle .app-header__idle-actions,
	.app-header[data-menu-open="true"][data-menu-exit="true"] .app-header__idle .app-header__idle-actions {
		@starting-style {
			transform: translateX(100%);
		}
		transform: translateX(0);
	}

	.app-header[data-menu-open="true"]:not([data-menu-exit="true"]) .app-header__idle .app-header__logo {
		transform: translateX(-180%);
	}

	.app-header[data-menu-open="true"]:not([data-menu-exit="true"]) .app-header__idle .app-header__idle-actions {
		transform: translateX(180%);
	}

	@media (min-width: 1024px) {
		.app-header[data-menu-open="true"]:not([data-menu-exit="true"]) .app-header__idle .app-header__logo,
		.app-header[data-menu-open="true"]:not([data-menu-exit="true"]) .app-header__idle .app-header__idle-actions {
			transform: translateX(0);
		}
	}

	.app-header[data-scrolled][data-menu-open="true"] .app-header__idle .app-header__logo {
		background-color: var(--header-glass-bg);
		border-color: var(--header-glass-border);
		backdrop-filter: blur(var(--header-glass-blur));
		-webkit-backdrop-filter: blur(var(--header-glass-blur));
		box-shadow: 0 2px 16px rgb(110 82 60 / 0.1);
	}

	.app-header[data-scrolled][data-menu-open="true"] .app-header__idle .app-header__cta {
		background-color: var(--header-glass-bg);
		color: var(--header-tan);
		border-color: var(--header-glass-border);
		backdrop-filter: blur(var(--header-glass-blur));
		-webkit-backdrop-filter: blur(var(--header-glass-blur));
		box-shadow: 0 2px 16px rgb(110 82 60 / 0.1);
	}

	.app-header[data-scrolled][data-menu-open="true"] .app-header__idle .app-header__menu {
