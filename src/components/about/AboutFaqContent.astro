---
import ContentCard from "@/components/ContentCard.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import { weddingNigeriaFaq } from "@/data/about-faq";
---

<HeroPageSurface
	bgSrc="/assets/faq.JPG"
	surfaceClass="about-faq"
	ariaLabelledBy="about-faq-heading"
>
	<ContentCard variant="secondary" class="about-faq__card">
		<p class="about-faq__eyebrow">Quick Answers</p>
		<h1 id="about-faq-heading" class="about-faq__title">Wedding FAQ</h1>
		<p class="about-faq__lede">
			A short list of common questions for our wedding in Nigeria.
		</p>

		<div class="about-faq__accordion" data-faq-accordion>
			{
				weddingNigeriaFaq.map((item, index) => {
					const panelId = `about-faq-panel-${index}`;
					return (
						<section class="about-faq__item" data-faq-item>
							<h2 class="about-faq__question-wrap">
								<button
									type="button"
									class="about-faq__question"
									aria-expanded={index === 0 ? "true" : "false"}
									aria-controls={panelId}
									data-faq-trigger
								>
									{item.question}
									<span aria-hidden="true" class="about-faq__icon">
										+
									</span>
								</button>
							</h2>
							<div
								id={panelId}
								class="about-faq__answer-shell"
								data-expanded={index === 0 ? "true" : "false"}
								aria-hidden={index === 0 ? "false" : "true"}
								data-faq-panel
							>
								<div class="about-faq__answer-shell-inner">
									<div class="about-faq__answer">
										<p>{item.answer}</p>
									</div>
								</div>
							</div>
						</section>
					);
				})
			}
		</div>
	</ContentCard>
</HeroPageSurface>

<script>
	function initAccordion(root: HTMLElement) {
		const items = [...root.querySelectorAll<HTMLElement>("[data-faq-item]")];
		if (!items.length) return;

		function setOpen(nextItem?: HTMLElement) {
			for (const item of items) {
				const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
				const panel = item.querySelector<HTMLElement>("[data-faq-panel]");
				if (!trigger || !panel) continue;

				const isOpen = item === nextItem;
				trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
				panel.setAttribute("data-expanded", isOpen ? "true" : "false");
				panel.setAttribute("aria-hidden", isOpen ? "false" : "true");
			}
		}

		for (const item of items) {
			const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
			if (!trigger) continue;

			trigger.addEventListener("click", () => {
				const isOpen = trigger.getAttribute("aria-expanded") === "true";
				setOpen(isOpen ? undefined : item);
			});
		}
	}

	document
		.querySelectorAll<HTMLElement>("[data-faq-accordion]")
		.forEach(initAccordion);
</script>

<style>
	:global(.about-faq.hero-page) {
		--travel-stack-gap: clamp(1rem, 2.5vw, 1.5rem);
		min-height: 100vh;
		min-height: 100dvh;
	}

	:global(.about-faq .hero-page__bg) {
		background-position: center top;
		filter: saturate(0.82) contrast(1.06) brightness(0.92);
	}

	:global(.about-faq__card.content-card--secondary) {
		background: rgb(255 255 255 / 0.28);
		border-color: rgb(110 82 60 / 0.2);
		box-shadow: 0 16px 40px rgb(78 59 44 / 0.12);
	}

	:global(.about-faq .hero-page__scrim) {
		background:
			radial-gradient(
				ellipse 92% 78% at 8% 6%,
				rgb(215 191 160 / 0.24),
				transparent 54%
			),
			radial-gradient(
				ellipse 88% 72% at 96% 94%,
				rgb(110 82 60 / 0.2),
				transparent 58%
			),
			linear-gradient(
				180deg,
				rgb(241 234 223 / 0.38) 0%,
				rgb(233 229 223 / 0.76) 46%,
				rgb(233 229 223 / 0.9) 100%
			);
	}

	:global(.about-faq__card) {
		width: min(100%, 52rem);
		margin-inline: auto;
	}

	.about-faq__eyebrow {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.78);
	}

	.about-faq__title {
		margin: 0.45rem 0 0;
		font-size: clamp(1.5rem, 4vw, 2rem);
	}

	.about-faq__lede {
		margin: 0.65rem 0 1rem;
		color: var(--text-muted);
	}

	.about-faq__accordion {
		display: grid;
		gap: 0.65rem;
	}

	.about-faq__item {
		border: 1px solid rgb(110 82 60 / 0.2);
		border-radius: 0.85rem;
		background: rgb(255 255 255 / 0.36);
		overflow: clip;
	}

	.about-faq__question-wrap {
		margin: 0;
	}

	.about-faq__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 0.85rem 1rem;
		border: 0;
		background: transparent;
		color: var(--text-primary);
		font: inherit;
		font-weight: 600;
		text-align: left;
		cursor: pointer;
	}

	.about-faq__question:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
		border-radius: 0.85rem;
	}

	.about-faq__icon {
		display: inline-grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		font-size: 1rem;
		line-height: 1;
		color: var(--text-muted);
		transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.about-faq__question[aria-expanded="true"] .about-faq__icon {
		transform: rotate(45deg);
	}

	.about-faq__answer-shell {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.about-faq__answer-shell[data-expanded="true"] {
		grid-template-rows: 1fr;
	}

	.about-faq__answer-shell-inner {
		min-height: 0;
		overflow: hidden;
	}

	.about-faq__answer {
		padding: 0 1rem 0.95rem;
		opacity: 0;
		transform: translateY(-0.25rem);
		transition:
			opacity 0.32s ease,
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.about-faq__answer-shell[data-expanded="true"] .about-faq__answer {
		opacity: 1;
		transform: translateY(0);
	}

	.about-faq__answer p {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
	}

	@media (prefers-reduced-motion: reduce) {
		.about-faq__answer-shell,
		.about-faq__answer,
		.about-faq__icon {
			transition: none;
		}
	}

	@media (min-width: 1024px) {
		:global(.about-faq .hero-page__bg) {
			background-position: center top;
		}
	}
</style>
