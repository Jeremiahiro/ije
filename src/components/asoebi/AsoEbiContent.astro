---
import ContentCard from "@/components/ContentCard.astro";
import {
	asoebiNextSteps,
	asoebiPageIntro,
	asoebiPrices,
	asoebiPrivateNote,
	asoEbiEvents,
} from "@/data/asoebi";
import { formatAsoebiPrice } from "@/lib/asoebiCurrency";
---

<div class="asoebi wrapper">
	<header class="asoebi__header">
		<p class="asoebi__eyebrow">Dress Code</p>
		<h1 class="asoebi__title">Asoebi &amp; Colors of the Day</h1>
		<p class="asoebi__intro">{asoebiPageIntro}</p>
	</header>

	<section class="asoebi__content" aria-label="Asoebi logistics">
		<div class="asoebi__events">
			{
				asoEbiEvents.map((event) => (
					<article
						class:list={[
							"asoebi__event",
							`asoebi__event--${event.accent}`,
						]}
						aria-labelledby={`event-${event.id}-title`}
					>
						<div class="asoebi__event-meta">
							<p class="asoebi__event-date">{event.date}</p>
							<h2 id={`event-${event.id}-title`} class="asoebi__event-name">
								{event.name}
							</h2>
						</div>

						<div class="asoebi__colors">
							{event.colors.map((color) => (
								<div class="asoebi__color-card">
									<div
										class="asoebi__color-swatch"
										style={`background: ${color.hex}`}
										aria-label={`${color.name} color swatch`}
									/>
									<div class="asoebi__color-info">
										<p class="asoebi__color-name">{color.name}</p>
										{color.detail ? (
											<p class="asoebi__color-detail">{color.detail}</p>
										) : null}
									</div>
								</div>
							))}
						</div>

						<ContentCard variant="default" class="asoebi__event-details">
							<p class="asoebi__role">
								<span class="asoebi__role-label">For women</span>
								{event.forWomen}
							</p>
							<p class="asoebi__role">
								<span class="asoebi__role-label">For men</span>
								{event.forMen}
								{event.capPriceNgn != null ? (
									<>
										{" "}
										Cap ={" "}
										<span
											data-asoebi-price={event.capPriceNgn}
											data-asoebi-price-currency="NGN"
										>
											{formatAsoebiPrice(event.capPriceNgn, "NGN")}
										</span>
										.
									</>
								) : null}
							</p>
						</ContentCard>
					</article>
				))
			}
		</div>

		<div class="asoebi__block">
			<h2 class="asoebi__block-title">Asoebi prices</h2>
			<p class="asoebi__price-note" data-asoebi-price-note hidden></p>
			<ul class="asoebi__price-list">
				{
					asoebiPrices.map((price) => (
						<li class="asoebi__price-item">
							<span class="asoebi__price-label">{price.label}</span>
							<span
								class="asoebi__price-amount"
								data-asoebi-price={price.amountNgn}
								data-asoebi-price-currency="NGN"
							>
								{formatAsoebiPrice(price.amountNgn, "NGN")}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<section class="asoebi__order" aria-labelledby="asoebi-order-title">
			<h2 id="asoebi-order-title" class="asoebi__block-title">How to order</h2>
			<ol class="asoebi__steps">
				{
					asoebiNextSteps.map((step, index) => (
						<li class="asoebi__step">
							<span class="asoebi__step-number" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<div class="asoebi__step-body">
								<h3 class="asoebi__step-title">{step.title}</h3>
								<p class="asoebi__step-detail">{step.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<ContentCard variant="secondary" class="asoebi__note">
			<p class="asoebi__note-copy">{asoebiPrivateNote}</p>
		</ContentCard>
	</section>
</div>

<style>
	.asoebi {
		padding-top: clamp(6.75rem, 13vw, 9.5rem);
		padding-bottom: clamp(4rem, 9vw, 7.5rem);
		display: grid;
		gap: clamp(3.5rem, 8vw, 6rem);
	}

	:global(.asoebi .content-card--default),
	:global(.asoebi .content-card--secondary) {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	:global(.asoebi .content-card--default) {
		background: rgb(255 255 255 / 0.88);
	}

	:global(.asoebi .content-card--secondary) {
		background: rgb(255 252 247 / 0.92);
	}

	.asoebi__header {
		text-align: center;
		max-width: 52rem;
		margin-inline: auto;
	}

	.asoebi__eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.75);
	}

	.asoebi__title {
		margin: 0 0 1.25rem;
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: 0.01em;
		color: #3a2e26;
	}

	.asoebi__intro {
		margin: 0;
		font-size: clamp(0.95rem, 2vw, 1.05rem);
		line-height: 1.82;
		color: rgb(58 46 38 / 0.85);
	}

	.asoebi__content {
		display: grid;
		gap: clamp(3.5rem, 9vw, 6.5rem);
	}

	.asoebi__block-title {
		margin: 0 0 1.5rem;
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 400;
		color: #3a2e26;
		text-align: center;
	}

	.asoebi__title,
	.asoebi__block-title,
	.asoebi__event-name,
	.asoebi__color-name,
	.asoebi__price-label,
	.asoebi__step-title,
	.asoebi__note-copy {
		text-wrap: balance;
	}

	.asoebi__intro,
	.asoebi__role,
	.asoebi__step-detail,
	.asoebi__price-note {
		text-wrap: pretty;
	}

	.asoebi__events {
		display: grid;
		gap: clamp(3rem, 7vw, 4.5rem);
	}

	@media (min-width: 900px) {
		.asoebi__events {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
	}

	.asoebi__event {
		display: grid;
		gap: 1.25rem;
	}

	.asoebi__event-meta {
		text-align: center;
	}

	.asoebi__event-date {
		margin: 0 0 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.asoebi__event--purple .asoebi__event-date {
		color: #5c3a82;
	}

	.asoebi__event--gold .asoebi__event-date {
		color: #9a7428;
	}

	.asoebi__event-name {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.45rem, 3.5vw, 1.9rem);
		font-weight: 400;
		line-height: 1.15;
		color: #3a2e26;
	}

	.asoebi__colors {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.asoebi__color-card {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.95rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.58);
		border-radius: 1.1rem;
		background: rgb(255 255 255 / 0.88);
		box-shadow: 0 12px 36px rgb(110 82 60 / 0.08);
	}

	.asoebi__color-swatch {
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.3),
			0 4px 12px rgb(0 0 0 / 0.18);
	}

	.asoebi__color-name {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: #3a2e26;
	}

	.asoebi__color-detail {
		margin: 0.2rem 0 0;
		font-size: 0.75rem;
		color: rgb(92 74 61 / 0.75);
	}

	:global(.asoebi__event-details) {
		margin-block: 0 !important;
		display: grid;
		gap: 0.85rem;
	}

	.asoebi__role {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgb(58 46 38 / 0.85);
	}

	.asoebi__role-label {
		display: block;
		margin-bottom: 0.2rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.72);
	}

	.asoebi__block {
		max-width: 44rem;
		margin-inline: auto;
		width: 100%;
	}

	.asoebi__price-note {
		margin: -0.65rem 0 1.15rem;
		text-align: center;
		font-size: 0.8rem;
		line-height: 1.5;
		color: rgb(92 74 61 / 0.75);
	}

	.asoebi__price-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.65rem;
	}

	.asoebi__price-item {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		padding: 0.95rem 1.15rem;
		border-radius: 1rem;
		border: 1px dashed rgb(196 152 58 / 0.45);
		background: rgb(255 252 247 / 0.92);
	}

	.asoebi__price-label {
		font-size: 0.9rem;
		line-height: 1.45;
		color: rgb(58 46 38 / 0.88);
	}

	.asoebi__price-amount {
		flex-shrink: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: #3a2e26;
	}

	.asoebi__order {
		max-width: min(40rem, 100%);
		margin-inline: auto;
		width: 100%;
	}

	.asoebi__steps {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: clamp(1.25rem, 3vw, 1.75rem);
	}

	.asoebi__step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1rem, 3vw, 1.5rem);
		align-items: start;
		padding: clamp(1.35rem, 3.5vw, 1.75rem);
		border-radius: 1.35rem;
		border: 1px solid rgb(110 82 60 / 0.14);
		background: rgb(255 255 255 / 0.92);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.75),
			0 14px 36px rgb(110 82 60 / 0.08);
	}

	.asoebi__step-number {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgb(110 82 60 / 0.2);
		background: rgb(110 82 60 / 0.08);
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		line-height: 1;
		color: #6e523c;
	}

	.asoebi__step-body {
		min-width: 0;
		padding-top: 0.2rem;
	}

	.asoebi__step-title {
		margin: 0 0 0.55rem;
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 2.5vw, 1.35rem);
		font-weight: 400;
		line-height: 1.25;
		color: #3a2e26;
	}

	.asoebi__step-detail {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.7;
		color: rgb(58 46 38 / 0.82);
	}

	:global(.asoebi__note) {
		margin-block: 0 !important;
		margin-inline: auto !important;
		max-width: 44rem;
		width: 100%;
		text-align: center;
	}

	.asoebi__note-copy {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.72;
		color: rgb(58 46 38 / 0.85);
	}
</style>

<script>
	import {
		asoebiCurrencyLabel,
		detectAsoebiCurrency,
		formatAsoebiPrice,
	} from "@/lib/asoebiCurrency";

	const currency = detectAsoebiCurrency();
	const nodes = document.querySelectorAll<HTMLElement>("[data-asoebi-price]");

	for (const node of nodes) {
		const amountNgn = Number(node.dataset.asoebiPrice);
		if (!Number.isFinite(amountNgn)) continue;
		node.textContent = formatAsoebiPrice(amountNgn, currency);
		node.dataset.asoebiPriceCurrency = currency;
	}

	const note = document.querySelector<HTMLElement>("[data-asoebi-price-note]");
	if (note && currency !== "NGN") {
		note.hidden = false;
		note.textContent = `Shown in ${asoebiCurrencyLabel(currency)} (approx. from Naira).`;
	}
</script>
