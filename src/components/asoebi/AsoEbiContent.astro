---
import ContentCard from "@/components/ContentCard.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import {
	asoebiMenNote,
	asoebiNextSteps,
	asoebiPageIntro,
	asoebiPriceNote,
	asoebiPrices,
	asoEbiEvents,
} from "@/data/asoebi";
import { formatAsoebiPrice } from "@/lib/asoebiCurrency";
---

<HeroPageSurface surfaceClass="asoebi-page" ariaLabelledBy="asoebi-heading">
	<header class="asoebi__header">
		<p class="asoebi__eyebrow">Dress Code</p>
		<h1 id="asoebi-heading" class="asoebi__title">Asoebi &amp; Colors of the Day</h1>
		<p class="asoebi__intro">{asoebiPageIntro}</p>
	</header>

	<section class="asoebi__content" aria-label="Asoebi logistics">
		<div class="asoebi__events">
			{
				asoEbiEvents.map((event) => (
					<article
						class:list={[
							"asoebi__event",
							`asoebi__event--${event.accent}`,
						]}
						aria-labelledby={`event-${event.id}-title`}
					>
						<div class="asoebi__event-meta">
							<p class="asoebi__event-date">{event.date}</p>
							<h2 id={`event-${event.id}-title`} class="asoebi__event-name">
								{event.name}
							</h2>
						</div>

						<div class="asoebi__colors">
							{event.colors.map((color) => (
								<div class="asoebi__color-card">
									<div
										class="asoebi__color-swatch"
										style={`background: ${color.hex}`}
										aria-label={`${color.name} color swatch`}
									/>
									<div class="asoebi__color-info">
										<p class="asoebi__color-name">{color.name}</p>
										{color.detail ? (
											<p class="asoebi__color-detail">{color.detail}</p>
										) : null}
									</div>
								</div>
							))}
						</div>

						<ContentCard variant="default" class="asoebi__event-details">
							<p class="asoebi__role">
								<span class="asoebi__role-label">For women</span>
								{event.forWomen}
							</p>
						</ContentCard>
					</article>
				))
			}
		</div>

		<ContentCard variant="default" class="asoebi__men-note">
			<p class="asoebi__role">
				<span class="asoebi__role-label">Men</span>
				{asoebiMenNote} Caps are listed in the prices below.
			</p>
		</ContentCard>

		<div
			class="asoebi__block asoebi__price-stack"
			id="asoebi-prices"
			data-price-stack
			style={`--stack-count: ${asoebiPrices.length}`}
		>
			<h2 class="asoebi__block-title">Asoebi prices</h2>
			<p class="asoebi__price-note">{asoebiPriceNote}</p>
			<ul class="asoebi__price-list" data-price-stack-list>
				{
					asoebiPrices.map((price, index) => (
						<li
							class="asoebi__price-item"
							style={`--stack-index: ${index}`}
							data-price-stack-item
						>
							<span class="asoebi__price-label">{price.label}</span>
							<span
								class="asoebi__price-amount"
								data-asoebi-price={price.amountNgn}
								data-asoebi-price-currency="NGN"
							>
								{formatAsoebiPrice(price.amountNgn, "NGN")}
							</span>
						</li>
					))
				}
			</ul>
		</div>

		<section class="asoebi__order" aria-labelledby="asoebi-order-title">
			<h2 id="asoebi-order-title" class="asoebi__block-title">How to order</h2>
			<ol class="asoebi__steps">
				{
					asoebiNextSteps.map((step, index) => (
						<li class="asoebi__step">
							<span class="asoebi__step-number" aria-hidden="true">
								{String(index + 1).padStart(2, "0")}
							</span>
							<div class="asoebi__step-body">
								<h3 class="asoebi__step-title">{step.title}</h3>
								<p class="asoebi__step-detail">{step.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</section>
	</section>
</HeroPageSurface>

<style>
	:global(.asoebi-page .content-card--default) {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
		background: rgb(255 255 255 / 0.88);
	}

	.asoebi__header {
		text-align: center;
		max-width: 52rem;
		margin: 0 auto clamp(1.5rem, 4vw, 2.25rem);
	}

	.asoebi__eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.75);
	}

	.asoebi__title {
		margin: 0 0 1.25rem;
		font-family: var(--font-heading);
		font-size: clamp(2.5rem, 7vw, 4.5rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: 0.01em;
		color: #3a2e26;
	}

	.asoebi__intro {
		margin: 0;
		font-size: clamp(0.95rem, 2vw, 1.05rem);
		line-height: 1.82;
		color: rgb(58 46 38 / 0.85);
	}

	.asoebi__content {
		display: grid;
		gap: clamp(1.5rem, 4vw, 2.5rem);
	}

	.asoebi__block-title {
		margin: 0 0 1.5rem;
		font-family: var(--font-heading);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 400;
		color: #3a2e26;
		text-align: center;
	}

	.asoebi__title,
	.asoebi__block-title,
	.asoebi__event-name,
	.asoebi__color-name,
	.asoebi__price-label,
	.asoebi__step-title {
		text-wrap: balance;
	}

	.asoebi__intro,
	.asoebi__role,
	.asoebi__step-detail,
	.asoebi__price-note {
		text-wrap: pretty;
	}

	.asoebi__events {
		display: grid;
		gap: clamp(1.5rem, 4vw, 2.25rem);
	}

	@media (min-width: 900px) {
		.asoebi__events {
			grid-template-columns: 1fr 1fr;
			align-items: start;
		}
	}

	.asoebi__event {
		display: grid;
		gap: 1.25rem;
	}

	.asoebi__event-meta {
		text-align: center;
	}

	.asoebi__event-date {
		margin: 0 0 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.asoebi__event--purple .asoebi__event-date {
		color: #5c3a82;
	}

	.asoebi__event--gold .asoebi__event-date {
		color: #9a7428;
	}

	.asoebi__event-name {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(1.45rem, 3.5vw, 1.9rem);
		font-weight: 400;
		line-height: 1.15;
		color: #3a2e26;
	}

	.asoebi__colors {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.asoebi__color-card {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		padding: 0.95rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.58);
		border-radius: 1.1rem;
		background: rgb(255 255 255 / 0.88);
		box-shadow: 0 12px 36px rgb(110 82 60 / 0.08);
	}

	.asoebi__color-swatch {
		flex-shrink: 0;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.3),
			0 4px 12px rgb(0 0 0 / 0.18);
	}

	.asoebi__color-name {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: #3a2e26;
	}

	.asoebi__color-detail {
		margin: 0.2rem 0 0;
		font-size: 0.75rem;
		color: rgb(92 74 61 / 0.75);
	}

	:global(.asoebi__event-details) {
		margin-block: 0 !important;
		display: grid;
		gap: 0.85rem;
	}

	:global(.asoebi__men-note) {
		margin-block: 0 !important;
		margin-inline: auto !important;
		max-width: 44rem;
		width: 100%;
	}

	.asoebi__role {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgb(58 46 38 / 0.85);
	}

	.asoebi__role-label {
		display: block;
		margin-bottom: 0.2rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.72);
	}

	.asoebi__block {
		max-width: 44rem;
		margin-inline: auto;
		width: 100%;
	}

	.asoebi__price-note {
		margin: -0.65rem 0 1.15rem;
		text-align: center;
		font-size: 0.88rem;
		line-height: 1.6;
		color: rgb(92 74 61 / 0.8);
	}

	.asoebi__price-stack {
		--stack-gap: 12px;
		--stack-peek: 12px;
		scroll-margin-top: calc(
			var(--site-header-height) + env(safe-area-inset-top, 0px) + 1rem
		);
	}

	.asoebi__price-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.asoebi__price-item {
		position: relative;
		z-index: calc(1 + var(--stack-index));
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin: 0;
		padding: 1.05rem 1.2rem;
		border-radius: 1rem;
		border: 1px solid rgb(196 152 58 / 0.4);
		background: rgb(255 250 242);
		box-shadow:
			0 12px 32px rgb(110 82 60 / 0.14),
			inset 0 1px 0 rgb(255 255 255 / 0.85);
		transform-origin: center top;
		margin-top: calc(
			var(--stack-index) * var(--stack-peek) - var(--stack-index) * 3.15rem
		);
		transform: scale(calc(1 - var(--stack-index) * 0.018));
	}

	.asoebi__price-item:first-child {
		margin-top: 0;
	}

	.asoebi__price-label {
		font-size: 0.9rem;
		line-height: 1.45;
		color: rgb(58 46 38 / 0.88);
	}

	.asoebi__price-amount {
		flex-shrink: 0;
		font-size: 0.95rem;
		font-weight: 700;
		color: #3a2e26;
	}

	@media (prefers-reduced-motion: reduce) {
		.asoebi__price-list {
			gap: 0.65rem;
		}

		.asoebi__price-item {
			margin-top: 0 !important;
			transform: none !important;
		}
	}

	.asoebi__order {
		max-width: min(40rem, 100%);
		margin-inline: auto;
		width: 100%;
	}

	.asoebi__steps {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: clamp(1.25rem, 3vw, 1.75rem);
	}

	.asoebi__step {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: clamp(1rem, 3vw, 1.5rem);
		align-items: start;
		padding: clamp(1.35rem, 3.5vw, 1.75rem);
		border-radius: 1.35rem;
		border: 1px solid rgb(110 82 60 / 0.14);
		background: rgb(255 255 255 / 0.92);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.75),
			0 14px 36px rgb(110 82 60 / 0.08);
	}

	.asoebi__step-number {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 999px;
		border: 1px solid rgb(110 82 60 / 0.2);
		background: rgb(110 82 60 / 0.08);
		font-family: var(--font-heading);
		font-size: 1rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		line-height: 1;
		color: #6e523c;
	}

	.asoebi__step-body {
		min-width: 0;
		padding-top: 0.2rem;
	}

	.asoebi__step-title {
		margin: 0 0 0.55rem;
		font-family: var(--font-heading);
		font-size: clamp(1.15rem, 2.5vw, 1.35rem);
		font-weight: 400;
		line-height: 1.25;
		color: #3a2e26;
	}

	.asoebi__step-detail {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.7;
		color: rgb(58 46 38 / 0.82);
	}
</style>

<script>
	import {
		detectAsoebiCurrency,
		formatAsoebiPrice,
	} from "@/lib/asoebiCurrency";

	const currency = detectAsoebiCurrency();
	const nodes = document.querySelectorAll<HTMLElement>("[data-asoebi-price]");

	for (const node of nodes) {
		const amountNgn = Number(node.dataset.asoebiPrice);
		if (!Number.isFinite(amountNgn)) continue;
		node.textContent = formatAsoebiPrice(amountNgn, currency);
		node.dataset.asoebiPriceCurrency = currency;
	}

	const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const stack = document.querySelector<HTMLElement>("[data-price-stack]");
	const items = [
		...document.querySelectorAll<HTMLElement>("[data-price-stack-item]"),
	];

	function clamp(value: number, min: number, max: number) {
		return Math.min(max, Math.max(min, value));
	}

	function lerp(from: number, to: number, t: number) {
		return from + (to - from) * t;
	}

	function progressForStack() {
		if (!stack) return 1;
		const rect = stack.getBoundingClientRect();
		const vh = window.innerHeight || 1;
		const start = vh * 0.72;
		const end = vh * 0.22;
		return clamp((start - rect.top) / Math.max(1, start - end), 0, 1);
	}

	function paintStack(progress: number) {
		if (!stack || !items.length) return;

		const styles = getComputedStyle(stack);
		const gap = Number.parseFloat(styles.getPropertyValue("--stack-gap")) || 12;
		const peek = Number.parseFloat(styles.getPropertyValue("--stack-peek")) || 12;

		for (let i = 0; i < items.length; i += 1) {
			const item = items[i];
			if (i === 0) {
				item.style.marginTop = "0px";
				item.style.transform = "none";
				continue;
			}

			const height = item.offsetHeight;
			const stackedMargin = -(height - peek);
			const openMargin = gap;
			const margin = lerp(stackedMargin, openMargin, progress);
			const scale = 1 - i * 0.018 * (1 - progress);

			item.style.marginTop = `${margin}px`;
			item.style.transform = `scale(${scale})`;
		}
	}

	function updatePriceStack() {
		if (!stack || !items.length) return;
		if (reduceMotion.matches) {
			for (const item of items) {
				item.style.marginTop = "";
				item.style.transform = "";
			}
			return;
		}

		paintStack(progressForStack());
	}

	let frame = 0;
	function requestUpdate() {
		if (frame) return;
		frame = window.requestAnimationFrame(() => {
			frame = 0;
			updatePriceStack();
		});
	}

	updatePriceStack();
	window.addEventListener("scroll", requestUpdate, { passive: true });
	window.addEventListener("resize", requestUpdate);
	reduceMotion.addEventListener("change", requestUpdate);
</script>
