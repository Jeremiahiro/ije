---
import ContentCard from "@/components/ContentCard.astro";
import {
  asoebiContact,
  asoebiPageIntro,
  asoEbiEvents,
  orderingSteps,
} from "@/data/asoebi";
---

<div class="asoebi wrapper">
  <!-- Page intro -->
  <header class="asoebi__header" data-reveal>
    <p class="asoebi__eyebrow">Dress Code</p>
    <h1 class="asoebi__title">Asoebi &amp; Colors of the Day</h1>
    <p class="asoebi__intro">{asoebiPageIntro}</p>
  </header>

  <!-- Event color palettes -->
  <div class="asoebi__events">
    {asoEbiEvents.map((event, eventIndex) => (
      <section class="asoebi__event" aria-labelledby={`event-${event.id}-title`} data-reveal data-delay={String(eventIndex + 1)}>
        <div class="asoebi__event-meta">
          <p class="asoebi__event-date">{event.date}</p>
          <h2 id={`event-${event.id}-title`} class="asoebi__event-name">{event.name}</h2>
        </div>

        <div class="asoebi__colors">
          {event.colors.map((color) => (
            <div class="asoebi__color-card">
              <div
                class="asoebi__color-swatch"
                style={`background: ${color.hex}`}
                aria-label={`${color.name} color swatch`}
              ></div>
              <div class="asoebi__color-info">
                <p class="asoebi__color-name">{color.name}</p>
              </div>
            </div>
          ))}
        </div>

        <ContentCard variant="default" class="asoebi__event-details">
          <p class="asoebi__event-notes">{event.notes}</p>
        </ContentCard>
      </section>
    ))}
  </div>

  <!-- How to order -->
  <section class="asoebi__ordering" aria-labelledby="ordering-title" data-reveal>
    <h2 id="ordering-title" class="asoebi__ordering-title">How to Get Dressed</h2>
    <div class="asoebi__steps">
      {orderingSteps.map((step) => (
        <ContentCard variant="default" class="asoebi__step">
          <p class="asoebi__step-number">0{step.step}</p>
          <h3 class="asoebi__step-title">{step.title}</h3>
          <p class="asoebi__step-detail">{step.detail}</p>
        </ContentCard>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <ContentCard variant="secondary" class="asoebi__contact" data-reveal>
    <p class="asoebi__contact-note">{asoebiContact.note}</p>
    {asoebiContact.email && (
      <a class="asoebi__contact-email" href={`mailto:${asoebiContact.email}`}>
        {asoebiContact.email}
      </a>
    )}
  </ContentCard>
</div>

<style>
  .asoebi {
    padding-top: clamp(6.75rem, 13vw, 9.5rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* Header */

  .asoebi__header {
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .asoebi__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.75);
  }

  .asoebi__title {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.01em;
    color: #3a2e26;
  }

  .asoebi__intro {
    margin: 0;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.82;
    color: rgb(58 46 38 / 0.85);
  }

  /* Events */

  .asoebi__events {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  .asoebi__event {
    display: grid;
    gap: 1.75rem;
  }

  .asoebi__event-meta {
    text-align: center;
  }

  .asoebi__event-date {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6e523c;
  }

  .asoebi__event-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    color: #3a2e26;
  }

  /* Color swatches */

  .asoebi__colors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.25rem;
  }

  .asoebi__color-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.58);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.38);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 12px 36px rgb(110 82 60 / 0.08);
  }

  .asoebi__color-swatch {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.3), 0 4px 12px rgb(0 0 0 / 0.18);
  }

  .asoebi__color-info {
    min-width: 0;
  }

  .asoebi__color-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
    color: #3a2e26;
  }

  /* Fabrics + notes card */

  .asoebi__event-details {
    margin-block: 0 !important;
  }

  .asoebi__fabrics-label {
    margin: 0 0 0.65rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.7);
  }

  .asoebi__fabrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .asoebi__fabrics li {
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    border: 1px solid rgb(110 82 60 / 0.22);
    background: rgb(110 82 60 / 0.07);
    font-size: 0.8rem;
    font-weight: 600;
    color: #5c4a3d;
  }

  .asoebi__event-notes {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.72;
    color: rgb(58 46 38 / 0.82);
  }

  /* Ordering */

  .asoebi__ordering {
    display: grid;
    gap: 1.5rem;
  }

  .asoebi__ordering-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    color: #3a2e26;
    text-align: center;
  }

  .asoebi__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .asoebi__step {
    margin-block: 0 !important;
  }

  .asoebi__step-number {
    margin: 0 0 0.5rem;
    font-size: 1.5rem;
    font-family: var(--font-heading);
    color: rgb(110 82 60 / 0.3);
    line-height: 1;
  }

  .asoebi__step-title {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 700;
    color: #3a2e26;
  }

  .asoebi__step-detail {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgb(58 46 38 / 0.78);
  }

  /* Contact */

  .asoebi__contact {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto !important;
    width: 100%;
  }

  .asoebi__contact-note {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    line-height: 1.72;
    color: rgb(58 46 38 / 0.82);
  }

  .asoebi__contact-email {
    display: inline-flex;
    padding: 0.7rem 1.5rem;
    border-radius: 9999px;
    background: #6e523c;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background 200ms ease,
      transform 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .asoebi__contact-email:hover {
      background: #5b4232;
      transform: translateY(-1px);
    }
  }
</style>
