---
import ContentCard from "@/components/ContentCard.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import { weddingFaq } from "@/data/faq";
---

<HeroPageSurface
	bgSrc="/assets/faq.JPG"
	surfaceClass="faq-page"
	ariaLabelledBy="faq-heading"
>
	<ContentCard variant="secondary" class="faq-page__card">
		<p class="faq-page__eyebrow">Quick Answers</p>
		<h1 id="faq-heading" class="faq-page__title">Wedding FAQ</h1>
		<p class="faq-page__lede">
			A short list of common questions for our wedding in Nigeria.
		</p>

		<div class="faq-page__accordion" data-faq-accordion>
			{
				weddingFaq.map((item, index) => {
					const panelId = `faq-panel-${index}`;
					return (
						<section class="faq-page__item" data-faq-item>
							<h2 class="faq-page__question-wrap">
								<button
									type="button"
									class="faq-page__question"
									aria-controls={panelId}
									data-faq-trigger
								>
									{item.question}
									<span aria-hidden="true" class="faq-page__icon">
										+
									</span>
								</button>
							</h2>
							<div
								id={panelId}
								class="faq-page__answer-shell"
								data-faq-panel
							>
								<div class="faq-page__answer-shell-inner">
									<div class="faq-page__answer">
										<p class="copy-preserve-breaks">
											{item.answer.map((part) =>
												part.type === "text" ? (
													part.value
												) : (
													<a
														href={part.href}
														{...(part.external
															? {
																	target: "_blank",
																	rel: "noopener noreferrer",
																}
															: {})}
													>
														{part.label}
													</a>
												),
											)}
										</p>
									</div>
								</div>
							</div>
						</section>
					);
				})
			}
		</div>
	</ContentCard>
</HeroPageSurface>

<script>
	function initAccordion(root: HTMLElement) {
		const items = [...root.querySelectorAll<HTMLElement>("[data-faq-item]")];
		if (!items.length) return;

		function setOpen(nextItem?: HTMLElement) {
			for (const item of items) {
				const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
				const panel = item.querySelector<HTMLElement>("[data-faq-panel]");
				if (!trigger || !panel) continue;

				const isOpen = item === nextItem;
				trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
				panel.setAttribute("data-expanded", isOpen ? "true" : "false");
				panel.setAttribute("aria-hidden", isOpen ? "false" : "true");
			}
		}

		for (const item of items) {
			const trigger = item.querySelector<HTMLButtonElement>("[data-faq-trigger]");
			if (!trigger) continue;

			trigger.addEventListener("click", () => {
				const isOpen = trigger.getAttribute("aria-expanded") === "true";
				setOpen(isOpen ? undefined : item);
			});
		}
	}

	document
		.querySelectorAll<HTMLElement>("[data-faq-accordion]")
		.forEach(initAccordion);
</script>

<style>
	:global(.faq-page.hero-page) {
		--travel-stack-gap: clamp(1rem, 2.5vw, 1.5rem);
		min-height: 100vh;
		min-height: 100dvh;
	}

	:global(.faq-page .hero-page__bg) {
		background-position: center top;
		filter: saturate(0.8) contrast(1.04) brightness(0.8);
	}

	:global(.faq-page__card.content-card--secondary) {
		background: rgb(230 220 206 / 0.48);
		border-color: rgb(96 72 53 / 0.28);
		box-shadow: 0 16px 40px rgb(58 42 31 / 0.2);
	}

	:global(.faq-page .hero-page__scrim) {
		background:
			radial-gradient(
				ellipse 92% 78% at 8% 6%,
				rgb(215 191 160 / 0.24),
				transparent 54%
			),
			radial-gradient(
				ellipse 88% 72% at 96% 94%,
				rgb(110 82 60 / 0.2),
				transparent 58%
			),
			linear-gradient(
				180deg,
				rgb(214 200 184 / 0.52) 0%,
				rgb(206 194 180 / 0.82) 46%,
				rgb(198 187 174 / 0.94) 100%
			);
	}

	:global(.faq-page__card) {
		width: min(100%, 52rem);
		margin-inline: auto;
	}

	.faq-page__eyebrow {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.78);
	}

	.faq-page__title {
		margin: 0.45rem 0 0;
		font-size: clamp(1.5rem, 4vw, 2rem);
	}

	.faq-page__lede {
		margin: 0.65rem 0 1rem;
		color: var(--text-muted);
	}

	.faq-page__accordion {
		display: grid;
		gap: 0.65rem;
	}

	.faq-page__item {
		border: 1px solid rgb(96 72 53 / 0.28);
		border-radius: 0.85rem;
		background: rgb(228 217 203 / 0.46);
		overflow: clip;
	}

	.faq-page__question-wrap {
		margin: 0;
	}

	.faq-page__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		padding: 0.85rem 1rem;
		border: 0;
		background: transparent;
		color: var(--text-primary);
		font: inherit;
		font-weight: 600;
		text-align: left;
		cursor: pointer;
	}

	.faq-page__question:focus-visible {
		outline: 2px solid var(--focus-ring);
		outline-offset: -2px;
		border-radius: 0.85rem;
	}

	.faq-page__icon {
		display: inline-grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		font-size: 1rem;
		line-height: 1;
		color: var(--text-muted);
		transition: transform 0.42s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.faq-page__question[aria-expanded="true"] .faq-page__icon {
		transform: rotate(45deg);
	}

	.faq-page__answer-shell {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.faq-page__answer-shell[data-expanded="true"] {
		grid-template-rows: 1fr;
	}

	.faq-page__answer-shell-inner {
		min-height: 0;
		overflow: hidden;
	}

	.faq-page__answer {
		padding: 0 1rem 0.95rem;
		opacity: 0;
		transform: translateY(-0.25rem);
		transition:
			opacity 0.32s ease,
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.faq-page__answer-shell[data-expanded="true"] .faq-page__answer {
		opacity: 1;
		transform: translateY(0);
	}

	.faq-page__answer p {
		margin: 0;
		color: var(--text-muted);
		line-height: 1.55;
	}

	.faq-page__answer a {
		color: #6e523c;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: rgb(91 66 50 / 0.5);
		text-underline-offset: 0.14em;
	}

	.faq-page__answer a:hover {
		text-decoration-color: rgb(91 66 50 / 0.85);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-page__answer-shell,
		.faq-page__answer,
		.faq-page__icon {
			transition: none;
		}
	}

	@media (min-width: 1024px) {
		:global(.faq-page .hero-page__bg) {
			background-position: center top;
		}
	}
</style>
