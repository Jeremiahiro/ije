---
interface Props {
	legend: string;
	errorId: string;
	class?: string;
}

const { legend, errorId, class: className } = Astro.props;
---

<fieldset class:list={["form-choice-group", className]}>
	<legend class="form-choice-group__legend">{legend}</legend>
	<div class="form-choice-group__row">
		<slot />
	</div>
	<p class="form-choice-group__error" id={errorId} hidden></p>
</fieldset>

<style>
	.form-choice-group {
		margin: 0;
		padding: 0;
		border: none;
		min-inline-size: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.form-choice-group__legend {
		display: block;
		padding: 0;
		margin: 0 0 0.4rem;
		max-width: 100%;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #6e523c;
		line-height: 1.35;
	}

	.form-choice-group__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.form-choice-group__error {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.35;
		color: #b54a3a;
	}

	.form-choice-group__error[hidden] {
		display: none !important;
	}
</style>
