---
import FormSelect, { type FormSelectOption } from "@/components/forms/FormSelect.astro";

interface Props {
	name: string;
	id: string;
	label: string;
	options: FormSelectOption[];
	placeholder?: string;
	hint?: string;
	required?: boolean;
	class?: string;
}

const props = Astro.props;
---

<FormSelect {...props} errorId={`rsvp-error-${props.name}`} />
