---
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import PillNav from "@/components/PillNav.astro";
import TravelFlightsContent from "@/components/travel/TravelFlightsContent.astro";
import TravelHotelsContent from "@/components/travel/TravelHotelsContent.astro";
import TravelPageIntro from "@/components/travel/TravelPageIntro.astro";
import TravelVisaContent from "@/components/travel/TravelVisaContent.astro";
import { travelFlightsPage } from "@/data/travel-flights";

const { hero } = travelFlightsPage;

const sectionNav = [
	{ id: "flights", label: "Flights" },
	{ id: "hotels", label: "Hotels" },
	{ id: "visa", label: "Visa" },
] as const;
---

<HeroPageSurface
	surfaceClass="travel-page"
	ariaLabelledBy="travel-heading"
>
	<TravelPageIntro
		eyebrow={hero.eyebrow}
		title={hero.title}
		headingId="travel-heading"
		ledes={hero.ledes}
		accentEyebrow
	/>

	<div class="travel-page__nav-wrap" data-pill-nav-wrapper>
		<PillNav
			links={sectionNav}
			aria-label="Travel sections"
			class="travel-page__section-nav"
			dockBottom={true}
		/>
	</div>

	<section
		id="flights"
		class="travel-page__section"
		aria-labelledby="travel-flights-section-title"
	>
		<h2 id="travel-flights-section-title" class="travel-page__visually-hidden">
			Flights
		</h2>

		<TravelFlightsContent />
	</section>

	<section
		id="hotels"
		class="travel-page__section"
		aria-labelledby="travel-hotels-section-title"
	>
		<TravelHotelsContent />
	</section>

	<section
		id="visa"
		class="travel-page__section"
		aria-labelledby="travel-visa-section-title"
	>
		<TravelVisaContent />
	</section>

</HeroPageSurface>

<style>
	:global(.travel-page.hero-page) {
		overflow-x: visible;
		--travel-stack-gap: clamp(1rem, 2.5vw, 1.75rem);
		--travel-block-gap: clamp(1rem, 3vw, 1.5rem);
		padding-bottom: clamp(5rem, 10vw, 7rem);
	}

	/* Fixed backgrounds force expensive per-frame paints while scrolling. */
	:global(.travel-page.hero-page .hero-page__bg) {
		background-attachment: scroll;
	}

	/*
	 * Large frosted shells (thousands of px tall) re-blur every scroll frame and
	 * make the whole page shimmer. Solid fills keep the look without live filters.
	 */
	:global(.travel-page .content-card--secondary),
	:global(.travel-page .content-card--default) {
		-webkit-backdrop-filter: none;
		backdrop-filter: none;
	}

	:global(.travel-page .content-card--secondary) {
		background: rgb(255 252 247 / 0.92);
	}

	:global(.travel-page .content-card--default) {
		background: rgb(255 255 255 / 0.88);
	}

	/* Skip scroll-reveal fade-ins — they read as flicker on this long page. */
	:global(.travel-page [data-reveal]) {
		opacity: 1;
		translate: 0 0;
		transition: none;
	}

	:global(.travel-page.hero-page .travel-page-intro) {
		margin: 0 auto clamp(2rem, 5vw, 3rem);
	}

	.travel-page__section {
		scroll-margin-bottom: calc(4rem + env(safe-area-inset-bottom, 0px));
	}

	.travel-page__section + .travel-page__section {
		margin-top: var(--travel-block-gap);
	}

	.travel-page__visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	/* Wrapper holds the PillNav's space in the layout at all times */
	.travel-page__nav-wrap {
		padding-bottom: clamp(1.1rem, 2.8vw, 1.5rem);
	}
</style>

<script>
	// Pin PillNav to bottom when wrapper scrolls off top; hide when footer starts revealing
	function initTravelNav() {
		const wrapper = document.querySelector<HTMLElement>("[data-pill-nav-wrapper]");
		const nav = wrapper?.querySelector<HTMLElement>("[data-pill-nav]");
		const shell = document.querySelector<HTMLElement>(".site-shell");
		if (!wrapper || !nav) return;

		// Lock wrapper min-height so layout never shifts when nav goes fixed.
		// Measure nav directly (not wrapper) so resize re-reads the true rendered height.
		// Wait for fonts.ready so FOUT doesn't produce a wrong initial measurement.
		const lockHeight = () => {
			if (!nav.dataset.pinnedBottom) {
				wrapper.style.minHeight = nav.offsetHeight + "px";
			}
		};
		requestAnimationFrame(lockHeight);
		document.fonts.ready.then(() => requestAnimationFrame(lockHeight));
		window.addEventListener("resize", () => requestAnimationFrame(lockHeight), { passive: true });

		// Hysteresis avoids pin/unpin chatter at the threshold (was restarting enter animation).
		let pinned = false;
		let hidden = false;
		let frame = 0;

		const syncNav = () => {
			const top = wrapper.getBoundingClientRect().top;
			const nextPinned = pinned ? top < 12 : top < -8;
			if (nextPinned !== pinned) {
				pinned = nextPinned;
				if (pinned) {
					nav.dataset.pinnedBottom = "";
				} else {
					delete nav.dataset.pinnedBottom;
					lockHeight();
				}
			}

			if (!shell) return;
			const shellBottom = shell.getBoundingClientRect().bottom;
			const hideLine = window.innerHeight + 40;
			const showLine = window.innerHeight + 140;
			const nextHidden = hidden
				? shellBottom < showLine
				: shellBottom < hideLine;
			if (nextHidden !== hidden) {
				hidden = nextHidden;
				if (hidden) {
					nav.dataset.navHidden = "";
				} else {
					delete nav.dataset.navHidden;
				}
			}
		};

		const onScrollOrResize = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				syncNav();
			});
		};

		window.addEventListener("scroll", onScrollOrResize, { passive: true });
		window.addEventListener("resize", onScrollOrResize, { passive: true });
		syncNav();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initTravelNav, { once: true });
	} else {
		initTravelNav();
	}
</script>
