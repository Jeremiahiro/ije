---
import ContentCard from "@/components/ContentCard.astro";
import TravelFlightRoute from "@/components/travel/TravelFlightRoute.astro";
import TravelStepCard from "@/components/travel/TravelStepCard.astro";
import { travelFlightsPage } from "@/data/travel-flights";

const { international, domestic } = travelFlightsPage;
---

<ContentCard variant="secondary" class="travel-flights__intl-shell">

	<div class="travel-page__outside-nigeria">
		<h2 class="travel-page__section-title">{international.title}</h2>
		{
			international.lede ? (
				<p class="travel-page__section-lede copy-preserve-breaks">{international.lede}</p>
			) : null
		}
	</div>
		{
			international.recommendedDates ? (
				<ContentCard
					variant="primary"
					class="travel-flights__recommended-dates"
				>
					<p class="travel-flights__eyebrow--card travel-flights__eyebrow--inline">
						{international.recommendedDates.eyebrowIcon ? (
							<span aria-hidden="true">
								{international.recommendedDates.eyebrowIcon}
							</span>
						) : null}{" "}
						{international.recommendedDates.eyebrow}
					</p>
					<p class="travel-flights__banner-title">
						{international.recommendedDates.title}
					</p>
					<p class="travel-flights__banner-copy copy-preserve-breaks">
						{international.recommendedDates.copy}
					</p>
					<p class="travel-flights__note copy-preserve-breaks">
						{international.recommendedDates.note}
					</p>
				</ContentCard>
			) : null
		}

		<TravelFlightRoute />

		<div class="travel-flights__steps" data-step-cards-section>
			<ol
				class="travel-flights__steps-grid"
				aria-label={international.stepsAriaLabel}
			>
				{
					international.steps.map((step, index) => (
						<li class="travel-flights__steps-item">
							<TravelStepCard step={step} index={index} />
						</li>
					))
				}
			</ol>
		</div>
	</ContentCard>

	{
		domestic?.steps && (
			<ContentCard
				variant="secondary"
				class="travel-flights__domestic-shell"
			>
				<h2 class="travel-flights__domestic-heading">
					{domestic.title}
				</h2>

				<div class="travel-flights__steps" data-step-cards-section>
					<ol
						class="travel-flights__steps-grid travel-flights__steps-grid--domestic"
						aria-label={domestic.stepsAriaLabel}
						data-card-count={domestic.steps.length}
					>
						{domestic.steps.map((step, index) => (
							<li class="travel-flights__steps-item">
								<TravelStepCard step={step} index={index} />
							</li>
						))}
					</ol>
				</div>
			</ContentCard>
		)
	}

<script>
	const desktopCardsQuery = window.matchMedia(
		"(min-width: 900px) and (hover: hover)",
	);

	function initStepCardsSection(section: HTMLElement) {
		const cards = [
			...section.querySelectorAll<HTMLElement>("[data-step-card]"),
		];
		if (!cards.length) return;

		const clearActive = () => {
			for (const card of cards) {
				delete card.dataset.active;
			}
		};

		const setActive = (card: HTMLElement) => {
			clearActive();
			card.dataset.active = "true";
		};

		const activateDefault = () => {
			setActive(cards[0]);
		};

		const handleCardEnter = (event: Event) => {
			if (!desktopCardsQuery.matches) return;
			setActive(event.currentTarget as HTMLElement);
		};

		if (desktopCardsQuery.matches) {
			activateDefault();
		}

		for (const card of cards) {
			card.addEventListener("mouseenter", handleCardEnter);
		}

		desktopCardsQuery.addEventListener("change", (event) => {
			if (event.matches) {
				activateDefault();
				return;
			}

			clearActive();
		});
	}

	document
		.querySelectorAll<HTMLElement>("[data-step-cards-section]")
		.forEach(initStepCardsSection);
</script>

<style>
	:global(.travel-flights__domestic-shell) .travel-flights__domestic-heading,
	:global(.travel-flights__domestic-shell) .travel-flights__domestic-lede {
		padding-inline: clamp(1rem, 4vw, 2.75rem);
	}

	:global(.travel-flights__intl-shell) {
		overflow: visible;
	}

	:global(.travel-flights__domestic-shell) {
		margin-top: var(--travel-block-gap);
		border-color: rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.32);
		box-shadow: 0 16px 48px rgb(110 82 60 / 0.1);
		width: 100%;
	}

	.travel-flights__domestic-heading {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		text-transform: uppercase;
	}

	.travel-flights__domestic-lede {
		margin-bottom: var(--travel-block-gap);
	}

	:global(.travel-flights__intl-shell > .content-card--primary) {
		margin-block: var(--travel-block-gap) 0;
	}

	.travel-flights__recommended-dates {
		margin-block-end: var(--travel-block-gap);
	}

	.travel-flights__steps {
		--step-slot-height: clamp(22rem, 42vw, 28rem);
		margin-block-start: clamp(1.25rem, 3vw, 2rem);
	}

	.travel-flights__steps-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.travel-flights__steps-grid--domestic {
		width: 100%;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.travel-flights__steps-grid--domestic[data-card-count="1"] {
		grid-template-columns: minmax(0, 18rem);
		justify-content: center;
	}

	.travel-flights__steps-item {
		display: grid;
		place-items: center;
		height: var(--step-slot-height);
		min-width: 0;
	}

	.travel-flights__eyebrow--card {
		margin: 0.35rem 0 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.78);
	}

	.travel-flights__eyebrow--inline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		text-transform: none;
		letter-spacing: 0.2em;
	}

	.travel-flights__banner-title {
		margin: 0;
		font-size: clamp(1.125rem, 2.2vw, 1.25rem);
		font-weight: 600;
		color: var(--text-primary);
	}

	.travel-flights__banner-copy {
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0.75rem 0 0;
	}

	.travel-flights__note {
		margin: 1rem 0 0;
		padding: 0.75rem 1rem;
		border-radius: 0.75rem;
		border: 1px dashed rgb(110 82 60 / 0.22);
		background: rgb(255 255 255 / 0.42);
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	@media (max-width: 899px) {
		:global(.travel-flights__intl-shell) {
			border-radius: clamp(1.35rem, 5vw, 2rem);
		}

		:global(.travel-flights__domestic-shell)
			.travel-flights__domestic-heading,
		:global(.travel-flights__domestic-shell)
			.travel-flights__domestic-lede {
			padding-inline: 0;
		}

		.travel-flights__steps-grid {
			grid-template-columns: 1fr;
		}

		.travel-flights__steps-item {
			height: auto;
		}

		.travel-flights__steps-grid--domestic[data-card-count="2"] {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 768px) {
		.travel-flights__banner-copy {
			font-size: 1rem;
		}
	}
</style>
