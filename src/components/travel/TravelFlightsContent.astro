---
import ContentCard from "@/components/ContentCard.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import TravelStepCard from "@/components/travel/TravelStepCard.astro";
import {
	domesticFlightStepCard,
	internationalFlightStepCards,
} from "@/data/travel-flights-steps";

const bgSrc = "/assets/travel.jpg";
---

<HeroPageSurface
	bgSrc={bgSrc}
	surfaceClass="travel-flights"
	ariaLabelledBy="travel-flights-heading"
>
	<header class="travel-flights__intro">
		<p class="travel-flights__eyebrow">Travel information</p>

		<h1 id="travel-flights-heading" class="travel-flights__title">
			Flights
		</h1>
		<p class="travel-flights__lede">
			Planning your route to Nigeria for our celebration -
			international connections through Lagos and regional travel to
			Abia&nbsp;State.
		</p>
	</header>

	<ContentCard variant="secondary" class="travel-flights__intl-shell">
		<h2 class="travel-flights__section-title">International guests</h2>
		<p class="travel-flights__section-lede">
			Arrive in Lagos, connect to Owerri, then we’ll help with ground
			logistics for guests arriving from outside&nbsp;Nigeria.
		</p>

		<ContentCard variant="primary" class="travel-flights__recommended-dates">
			<p
				class="travel-flights__eyebrow travel-flights__eyebrow--card travel-flights__eyebrow--inline"
			>
				<span aria-hidden="true">📅</span> Recommended arrival dates
			</p>
			<p class="travel-flights__banner-title">
				Plan to arrive in Lagos on December 30th or 31st
			</p>
			<p class="travel-flights__banner-copy">
				These are the two days we coordinate airport assistance,
				ground transportation, and overall travel coordination for
				international guests.
			</p>
			<p class="travel-flights__note">
				Guests arriving outside those dates will need to arrange
				their own transportation to&nbsp;Abia&nbsp;State.
			</p>
		</ContentCard>

		<div class="travel-flights__steps" data-step-cards-section>
			<ol class="travel-flights__steps-grid" aria-label="Trip steps">
				{
					internationalFlightStepCards.map((step, index) => (
						<li class="travel-flights__steps-item">
							<TravelStepCard step={step} index={index} />
						</li>
					))
				}
			</ol>
		</div>
	</ContentCard>

	<ContentCard variant="secondary" class="travel-flights__domestic-shell">
		<h2 class="travel-flights__section-title travel-flights__domestic-heading">
			Travelling within Nigeria
		</h2>
		<p class="travel-flights__section-lede travel-flights__domestic-lede">
			Flying domestically? You can skip Lagos and head straight to
			Owerri.
		</p>

		<div class="travel-flights__steps travel-flights__steps--solo" data-step-cards-section>
			<TravelStepCard step={domesticFlightStepCard} />
		</div>
	</ContentCard>
</HeroPageSurface>

<script>
	const desktopCardsQuery = window.matchMedia(
		"(min-width: 900px) and (hover: hover)",
	);

	function initStepCardsSection(section: HTMLElement) {
		const cards = [
			...section.querySelectorAll<HTMLElement>("[data-step-card]"),
		];
		if (!cards.length) return;

		const clearActive = () => {
			for (const card of cards) {
				delete card.dataset.active;
			}
		};

		const setActive = (card: HTMLElement) => {
			clearActive();
			card.dataset.active = "true";
		};

		const activateDefault = () => {
			setActive(cards[0]);
		};

		const handleCardEnter = (event: Event) => {
			if (!desktopCardsQuery.matches) return;
			setActive(event.currentTarget as HTMLElement);
		};

		if (desktopCardsQuery.matches) {
			activateDefault();
		}

		for (const card of cards) {
			card.addEventListener("mouseenter", handleCardEnter);
		}

		desktopCardsQuery.addEventListener("change", (event) => {
			if (event.matches) {
				activateDefault();
				return;
			}

			clearActive();
		});
	}

	document
		.querySelectorAll<HTMLElement>("[data-step-cards-section]")
		.forEach(initStepCardsSection);
</script>

<style>
	:global(.travel-flights.hero-page) {
		--travel-stack-gap: clamp(1rem, 2.5vw, 1.75rem);
		--travel-block-gap: clamp(1rem, 3vw, 1.5rem);
	}

	.travel-flights__intro {
		margin: 0 auto clamp(2rem, 5vw, 3rem);
		max-width: 52rem;
		text-align: center;
	}

	.travel-flights__eyebrow {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.travel-flights__title {
		margin: 0;
		font-size: clamp(2.125rem, 5.5vw + 1rem, 3rem);
		font-weight: 600;
		line-height: 1.06;
		letter-spacing: -0.02em;
	}

	.travel-flights__lede {
		margin: 1.25rem auto 0;
		max-width: 42rem;
		text-wrap: pretty;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	:global(.travel-flights__intl-shell) .travel-flights__section-title,
	:global(.travel-flights__intl-shell) .travel-flights__section-lede,
	:global(.travel-flights__domestic-shell) .travel-flights__domestic-heading,
	:global(.travel-flights__domestic-shell) .travel-flights__domestic-lede {
		padding-inline: clamp(1rem, 4vw, 2.75rem);
	}

	:global(.travel-flights__intl-shell) {
		overflow: visible;
	}

	:global(.travel-flights__domestic-shell) {
		margin-top: var(--travel-block-gap);
		border-color: rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.32);
		box-shadow: 0 16px 48px rgb(110 82 60 / 0.1);
		width: 100%;
	}

	.travel-flights__section-title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.travel-flights__section-lede {
		margin: 0 0 var(--travel-block-gap);
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-flights__domestic-lede {
		margin-bottom: var(--travel-block-gap);
	}

	:global(.travel-flights__intl-shell > .content-card--primary) {
		margin-block: var(--travel-block-gap) 0;
	}

	.travel-flights__recommended-dates {
		margin-block-end: var(--travel-block-gap);
	}

	.travel-flights__steps {
		--step-slot-height: clamp(22rem, 42vw, 28rem);
		margin-block-start: clamp(1.25rem, 3vw, 2rem);
	}

	.travel-flights__steps-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(0.85rem, 2vw, 1.25rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.travel-flights__steps-item {
		display: grid;
		place-items: center;
		height: var(--step-slot-height);
		min-width: 0;
	}

	.travel-flights__steps--solo {
		display: grid;
		place-items: center;
		height: var(--step-slot-height);
		max-width: min(100%, 18rem);
		margin-inline: auto;
	}

	.travel-flights__eyebrow--card {
		margin: 0.35rem 0 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.78);
	}

	.travel-flights__eyebrow--inline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1rem;
		text-transform: none;
		letter-spacing: 0.2em;
	}

	.travel-flights__banner-title {
		margin: 0;
		font-size: clamp(1.125rem, 2.2vw, 1.25rem);
		font-weight: 600;
		color: var(--text-primary);
	}

	.travel-flights__banner-copy {
		max-width: 48rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0.75rem 0 0;
	}

	.travel-flights__note {
		margin: 1rem 0 0;
		padding: 0.75rem 1rem;
		border-radius: 0.75rem;
		border: 1px dashed rgb(110 82 60 / 0.22);
		background: rgb(255 255 255 / 0.42);
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	@media (max-width: 899px) {
		:global(.travel-flights__intl-shell) {
			border-radius: clamp(1.35rem, 5vw, 2rem);
		}

		:global(.travel-flights__intl-shell) .travel-flights__section-title,
		:global(.travel-flights__intl-shell) .travel-flights__section-lede,
		:global(.travel-flights__domestic-shell) .travel-flights__domestic-heading,
		:global(.travel-flights__domestic-shell) .travel-flights__domestic-lede {
			padding-inline: 0;
		}

		.travel-flights__steps-grid {
			grid-template-columns: 1fr;
		}

		.travel-flights__steps-item {
			height: auto;
		}

		.travel-flights__steps--solo {
			height: auto;
			max-width: 100%;
		}
	}

	@media (min-width: 768px) {
		.travel-flights__eyebrow {
			font-size: 0.75rem;
		}

		.travel-flights__lede {
			font-size: 1.125rem;
		}

		.travel-flights__section-lede,
		.travel-flights__banner-copy {
			font-size: 1rem;
		}
	}
</style>
