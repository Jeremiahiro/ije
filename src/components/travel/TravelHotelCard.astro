---
import ContentCard from "@/components/ContentCard.astro";
import type { Hotel } from "@/data/travel-hotels";

interface Props {
	hotel: Hotel;
	class?: string;
}

const { hotel, class: className } = Astro.props;

const website = hotel.website?.trim() || undefined;
const mapUrl = hotel.mapUrl?.trim() || undefined;

const distanceEmoji = hotel.distanceKind === "airport" ? "✈️" : "🚗";
const distanceLabel =
	hotel.distanceKind === "airport"
		? "Distance to airport"
		: "Distance to venue";

const offers = (hotel.offers ?? []).filter((o) => o.trim().length > 0);
const guestIntel = (hotel.guestIntel ?? []).filter(
	(g) => g.title.trim().length > 0 && g.body.trim().length > 0,
);

const externalRel = "noopener noreferrer";
---

<ContentCard variant="default" class:list={["travel-hotel-card", className]}>
	<div class="travel-hotel-card__main">
		<h3 class="travel-hotel-card__name">{hotel.name}</h3>
		<p class="travel-hotel-card__description">{hotel.description}</p>

		<dl class="travel-hotel-card__facts">
			<div class="travel-hotel-card__fact">
				<dt class="travel-hotel-card__fact-label">
					<span aria-hidden="true">📍</span> Location
				</dt>
				<dd class="travel-hotel-card__fact-value">{hotel.location}</dd>
			</div>
			<div class="travel-hotel-card__fact">
				<dt class="travel-hotel-card__fact-label">
					<span aria-hidden="true">{distanceEmoji}</span> {distanceLabel}
				</dt>
				<dd class="travel-hotel-card__fact-value">{hotel.distance}</dd>
			</div>
			<div class="travel-hotel-card__fact">
				<dt class="travel-hotel-card__fact-label">
					<span aria-hidden="true">⭐</span> Best for
				</dt>
				<dd class="travel-hotel-card__fact-value">{hotel.bestFor}</dd>
			</div>
		</dl>

		{
			offers.length ? (
				<div class="travel-hotel-card__offers" aria-label="Offers and perks">
					<p class="travel-hotel-card__offers-label">Perks</p>
					<ul class="travel-hotel-card__offer-pills">
						{offers.map((offer) => (
							<li class="travel-hotel-card__offer-pill">{offer}</li>
						))}
					</ul>
				</div>
			) : null
		}

		{
			guestIntel.length ? (
				<div class="travel-hotel-card__intel" aria-label="Insider tips">
					{guestIntel.map((item) => (
						<div
							class:list={[
								"travel-hotel-card__intel-item",
								item.kind === "discount" &&
									"travel-hotel-card__intel-item--discount",
								item.kind === "tip" &&
									"travel-hotel-card__intel-item--tip",
								item.kind === "transport" &&
									"travel-hotel-card__intel-item--transport",
							]}
						>
							<p class="travel-hotel-card__intel-title">
								{item.kind === "discount" ? (
									<>
										<span class="travel-hotel-card__intel-icon" aria-hidden="true">
											🎟️
										</span>
									</>
								) : null}
								{item.kind === "tip" ? (
									<>
										<span class="travel-hotel-card__intel-icon" aria-hidden="true">
											💡
										</span>
									</>
								) : null}
								{item.kind === "transport" ? (
									<>
										<span class="travel-hotel-card__intel-icon" aria-hidden="true">
											🚐
										</span>
									</>
								) : null}
								<span>{item.title}</span>
							</p>
							<p
								class:list={[
									"travel-hotel-card__intel-body",
									item.kind === "discount" &&
										"travel-hotel-card__intel-body--mono",
								]}
							>
								{item.body}
							</p>
						</div>
					))}
				</div>
			) : null
		}
	</div>

	{
		website || mapUrl ? (
			<div class="travel-hotel-card__actions">
				{website ? (
					<a
						class="travel-hotel-card__btn travel-hotel-card__btn--primary"
						href={website}
						target="_blank"
						rel={externalRel}
					>
						Website
					</a>
				) : null}
				{mapUrl ? (
					<a
						class="travel-hotel-card__btn travel-hotel-card__btn--secondary"
						href={mapUrl}
						target="_blank"
						rel={externalRel}
					>
						View on map
					</a>
				) : null}
			</div>
		) : null
	}
</ContentCard>

<style>
	:global(.travel-hotel-card) {
		margin-block: 0;
		height: 100%;
		min-height: 0;
		display: flex;
		flex-direction: column;
		text-align: left;
	}

	.travel-hotel-card__main {
		flex: 1 1 auto;
		min-height: 0;
	}

	.travel-hotel-card__name {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}

	.travel-hotel-card__description {
		margin: 0.5rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-hotel-card__facts {
		margin: 1rem 0 0;
		display: grid;
		gap: 0.65rem;
	}

	.travel-hotel-card__fact {
		margin: 0;
		padding: 0.55rem 0 0;
		border-top: 1px solid rgb(110 82 60 / 0.12);
	}

	.travel-hotel-card__fact:first-child {
		padding-top: 0;
		border-top: 0;
	}

	.travel-hotel-card__fact-label {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: rgb(92 74 61 / 0.78);
	}

	.travel-hotel-card__fact-value {
		margin: 0.25rem 0 0;
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--text-primary);
	}

	.travel-hotel-card__offers {
		margin: 1rem 0 0;
	}

	.travel-hotel-card__offers-label {
		margin: 0 0 0.4rem;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: rgb(92 74 61 / 0.78);
	}

	.travel-hotel-card__offer-pills {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.travel-hotel-card__offer-pill {
		margin: 0;
		padding: 0.28rem 0.62rem;
		border-radius: 999px;
		border: 1px solid rgb(110 82 60 / 0.18);
		background: rgb(255 255 255 / 0.55);
		font-size: 0.78rem;
		line-height: 1.35;
		color: var(--text-muted);
	}

	.travel-hotel-card__intel {
		margin: 1.1rem 0 1.35rem;
		display: grid;
		gap: 0.55rem;
	}

	.travel-hotel-card__intel-item {
		margin: 0;
		padding: 0.75rem 0.85rem;
		border-radius: 0.75rem;
		border: 1px solid rgb(110 82 60 / 0.14);
		background: rgb(255 255 255 / 0.38);
	}

	.travel-hotel-card__intel-item--discount {
		border-style: dashed;
		border-color: rgb(110 82 60 / 0.26);
		background: linear-gradient(
			135deg,
			rgb(255 252 247 / 0.85) 0%,
			rgb(250 244 236 / 0.65) 100%
		);
	}

	.travel-hotel-card__intel-item--tip {
		background: rgb(255 255 255 / 0.42);
	}

	.travel-hotel-card__intel-item--transport {
		background: rgb(248 252 255 / 0.55);
		border-color: rgb(90 120 140 / 0.18);
	}

	.travel-hotel-card__intel-title {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--text-primary);
	}

	.travel-hotel-card__intel-icon {
		flex-shrink: 0;
	}

	.travel-hotel-card__intel-body {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		line-height: 1.52;
		color: var(--text-muted);
	}

	.travel-hotel-card__intel-body--mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
			"Liberation Mono", "Courier New", monospace;
		font-size: 0.8125rem;
	}

	.travel-hotel-card__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		flex-shrink: 0;
		margin-top: auto;
		padding-top: 1.25rem;
		border-top: 1px solid rgb(110 82 60 / 0.12);
	}

	.travel-hotel-card__btn {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem 0.95rem;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
		transition:
			background 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.travel-hotel-card__btn--primary {
		background: rgb(110 82 60 / 0.12);
		border-color: rgb(110 82 60 / 0.28);
		color: #4e3b2c;
	}

	.travel-hotel-card__btn--primary:hover {
		background: rgb(110 82 60 / 0.18);
	}

	.travel-hotel-card__btn--secondary {
		background: rgb(255 255 255 / 0.35);
		border-color: rgb(110 82 60 / 0.2);
		color: var(--text-muted);
	}

	.travel-hotel-card__btn--secondary:hover {
		background: rgb(255 255 255 / 0.55);
		color: var(--text-primary);
	}
</style>
