---
import ContentCard from "@/components/ContentCard.astro";
import TravelHotelCard from "@/components/travel/TravelHotelCard.astro";
import TravelPageIntro from "@/components/travel/TravelPageIntro.astro";
import PillNav from "@/components/PillNav.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import {
	travelHotelsPage,
} from "@/data/travel-hotels";

const bgSrc = "/assets/hotel.jpg";
const { introLede, regions, pageTip } = travelHotelsPage;

const jumpLinks = regions.map((r) => ({ id: r.id, label: r.jumpLabel }));
---

<HeroPageSurface
	bgSrc={bgSrc}
	surfaceClass="travel-hotels"
	ariaLabelledBy="travel-hotels-heading"
>
	<TravelPageIntro
		eyebrow="Where to stay"
		title="Hotels"
		headingId="travel-hotels-heading"
		ledes={[introLede]}
	/>

	<ContentCard variant="secondary" class="travel-hotels__main-shell">
		<PillNav links={jumpLinks} aria-label="Cities" />

		{
			regions.map((region) => {
				const headingId = `travel-hotels-${region.id}-title`;
				return (
					<ContentCard
						id={region.id}
						class="travel-hotels__region"
						aria-labelledby={headingId}
					>
						<p class="travel-hotels__region-eyebrow">{region.eyebrow}</p>
						<h2 id={headingId} class="travel-hotels__region-title">
							{region.title}
						</h2>
						<p class="travel-hotels__region-lede">{region.lede}</p>
						<div class="travel-hotels__grid">
							{region.hotels.map((hotel) => (
								<TravelHotelCard hotel={hotel} />
							))}
						</div>
					</ContentCard>
				);
			})
		}
	</ContentCard>

	<ContentCard variant="primary" class="travel-hotels__tip">
		<p class="travel-hotels__tip-eyebrow travel-hotels__eyebrow--inline">
			{pageTip.eyebrow}
		</p>
		<p class="travel-hotels__tip-title">{pageTip.title}</p>
		<p class="travel-hotels__tip-copy">{pageTip.body}</p>
	</ContentCard>
</HeroPageSurface>

<style>
	:global(.travel-hotels.hero-page) {
		overflow-x: visible;
		--travel-stack-gap: clamp(1rem, 2.6vw, 1.5rem);
		--travel-block-gap: clamp(1rem, 3vw, 1.5rem);
		--pill-nav-sticky-top: calc(
			var(--site-header-height) + env(safe-area-inset-top, 0px) + 1.5rem
		);
		--travel-hotels-section-scroll-margin: calc(
			var(--pill-nav-sticky-top) + 3.25rem
		);
	}

	:global(.travel-hotels.hero-page .travel-page-intro__lede) {
		max-width: 42rem;
	}

	:global(.travel-hotels__main-shell) {
		width: 100%;
		border-color: rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.32);
		box-shadow: 0 16px 48px rgb(110 82 60 / 0.1);
		padding: clamp(1rem, 2.4vw, 1.4rem);
	}

	:global(.travel-hotels__main-shell) .travel-hotels__region:last-of-type {
		margin-bottom: 0;
	}

	.travel-hotels__region {
		scroll-margin-top: var(--travel-hotels-section-scroll-margin);
		margin-bottom: clamp(2.5rem, 5.5vw, 4.25rem);
	}

	.travel-hotels__region-eyebrow {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.85);
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.travel-hotels__region-title {
		margin: 0.65rem 0 0;
		font-size: clamp(1.2rem, 2.4vw, 1.45rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}

	.travel-hotels__region-lede {
		margin: 0.65rem 0 1rem;
		max-width: 44rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-hotels__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--travel-stack-gap);
		align-items: stretch;
	}

	:global(.travel-hotels__grid .content-card.travel-hotel-card) {
		margin-block: 0;
	}

	.travel-hotels__tip {
		margin-top: clamp(0.25rem, 2vw, 0.75rem);
	}

	.travel-hotels__tip-eyebrow {
		margin: 0 0 0.85rem;
	}

	.travel-hotels__eyebrow--inline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-transform: none;
		letter-spacing: 0.2em;
		font-size: 0.6875rem;
		font-weight: 700;
		color: rgb(92 74 61 / 0.78);
	}

	.travel-hotels__tip-title {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.2rem);
		font-weight: 600;
		color: var(--text-primary);
	}

	.travel-hotels__tip-copy {
		margin: 0.65rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	@media (max-width: 899px) {
		.travel-hotels__grid {
			grid-template-columns: 1fr;
		}

		:global(.travel-hotels__main-shell) {
			border-radius: clamp(1.35rem, 5vw, 2rem);
		}
	}

	@media (min-width: 768px) {
		.travel-hotels__region-lede,
		.travel-hotels__tip-copy {
			font-size: 1rem;
		}
	}
</style>
