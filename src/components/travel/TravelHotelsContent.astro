---
import ContentCard from "@/components/ContentCard.astro";
import TravelHotelCard from "@/components/travel/TravelHotelCard.astro";
import {
	travelHotelsPage,
} from "@/data/travel-hotels";

const { introLede, regions } = travelHotelsPage;
---
<ContentCard variant="secondary" class="travel-hotels__main-shell">

	<div data-reveal>
		<h2 id="travel-hotels-section-title" class="travel-hotels__page-title">
			Hotels
		</h2>
		<p class="travel-hotels__page-lede copy-preserve-breaks">{introLede}</p>
	</div>

		{
			regions.map((region) => {
				const headingId = `travel-hotels-${region.id}-title`;
				return (
					<section
						id={region.id}
						class="travel-hotels__region"
						aria-labelledby={headingId}
					>
						<div data-reveal>
							<p class="travel-hotels__region-eyebrow">{region.eyebrow}</p>
							<h3 id={headingId} class="travel-hotels__region-title">
								{region.title}
							</h3>
							<p class="travel-hotels__region-lede copy-preserve-breaks">{region.lede}</p>
						</div>
						<div class="travel-hotels__grid">
							{region.hotels.map((hotel, i) => (
								<div data-reveal data-delay={String((i % 4) + 1)}>
									<TravelHotelCard hotel={hotel} />
								</div>
							))}
						</div>
					</section>
				);
			})
		}
	</ContentCard>

<style>
	.travel-hotels__page-title {
		margin: 0 0 0.5rem;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.travel-hotels__page-lede {
		margin: 0 0 var(--travel-block-gap);
		max-width: 42rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	:global(.travel-hotels__main-shell) {
		width: 100%;
		border-color: rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.32);
		box-shadow: 0 16px 48px rgb(110 82 60 / 0.1);
		padding: clamp(1rem, 2.4vw, 1.4rem);
	}

	:global(.travel-hotels__main-shell) .travel-hotels__region:last-of-type {
		margin-bottom: 0;
	}

	.travel-hotels__region {
		scroll-margin-top: var(--travel-hotels-section-scroll-margin);
		margin-bottom: clamp(2.5rem, 5.5vw, 4.25rem);
	}

	.travel-hotels__region-eyebrow {
		margin: 0;
		font-size: 0.6875rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: rgb(92 74 61 / 0.85);
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.travel-hotels__region-title {
		margin: 0.65rem 0 0;
		font-size: clamp(1.2rem, 2.4vw, 1.45rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text-primary);
	}

	.travel-hotels__region-lede {
		margin: 0.65rem 0 1rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	.travel-hotels__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--travel-stack-gap);
		align-items: stretch;
	}

	:global(.travel-hotels__grid .content-card.travel-hotel-card) {
		margin-block: 0;
	}

	.travel-hotels__eyebrow--inline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-transform: none;
		letter-spacing: 0.2em;
		font-size: 0.6875rem;
		font-weight: 700;
		color: rgb(92 74 61 / 0.78);
	}

	@media (max-width: 899px) {
		.travel-hotels__grid {
			grid-template-columns: 1fr;
		}

		:global(.travel-hotels__main-shell) {
			border-radius: clamp(1.35rem, 5vw, 2rem);
		}
	}

	@media (min-width: 768px) {
		.travel-hotels__page-lede,
		.travel-hotels__region-lede {
			font-size: 1rem;
		}
	}
</style>
