---
import { TRAVEL_MAP_URL_INTL, TRAVEL_MAP_URL_UK } from "@/data/travel-map-urls";

interface Props {
	title?: string;
	width?: string;
	height?: number;
	allow?: string;
	class?: string;
}

const {
	title = "TravelMap embed",
	width = "100%",
	height = 550,
	allow = "fullscreen",
	class: className,
} = Astro.props;

const heightAttr = String(height);
---

<div class:list={["travel-map-embed", className]} data-travel-map-root>
	<iframe
		class="travel-map-embed__frame"
		src={TRAVEL_MAP_URL_INTL}
		width={width}
		height={heightAttr}
		title={title}
		allow={allow}
		loading="lazy"
	></iframe>
</div>

<script define:vars={{ ukUrl: TRAVEL_MAP_URL_UK, intlUrl: TRAVEL_MAP_URL_INTL }}>
	document.querySelectorAll("[data-travel-map-root]").forEach((root) => {
		const frame = root.querySelector("iframe");
		if (!frame) return;

		const useUk = () => {
			if (frame.getAttribute("src") !== ukUrl) frame.setAttribute("src", ukUrl);
		};

		const run = async () => {
			try {
				const ctl = new AbortController();
				const id = window.setTimeout(() => ctl.abort(), 5000);
				const res = await fetch("https://get.geojs.io/v1/ip/country.json", {
					signal: ctl.signal,
				});
				window.clearTimeout(id);
				if (!res.ok) return;
				const data = await res.json();
				if (
					data &&
					typeof data.country === "string" &&
					data.country === "GB"
				) {
					useUk();
				}
			} catch {
				/* keep intl map */
			}
		};

		void run();
	});
</script>

<style>
	.travel-map-embed {
		box-sizing: border-box;
		width: 100%;
		max-width: 100%;
		overflow: hidden;
		border-radius: 1rem;
		border: 1px solid rgb(110 82 60 / 0.12);
		background: rgb(255 255 255 / 0.35);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.55),
			0 12px 36px rgb(110 82 60 / 0.08);
	}

	.travel-map-embed__frame {
		display: block;
		width: 100%;
		max-width: 100%;
		border: 0;
	}
</style>
