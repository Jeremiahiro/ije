---
interface Props {
	eyebrow: string;
	title: string;
	headingId: string;
	ledes?: string[];
	className?: string;
	accentEyebrow?: boolean;
}

const {
	eyebrow,
	title,
	headingId,
	ledes = [],
	className,
	accentEyebrow = false,
} = Astro.props;
---

<header
	class:list={[
		"travel-page-intro",
		className,
		accentEyebrow && "travel-page-intro--accent-eyebrow",
	]}
	data-reveal
>
	<p class="travel-page-intro__eyebrow">{eyebrow}</p>
	<h1 id={headingId} class="travel-page-intro__title">{title}</h1>
	{
		ledes.map((lede) => <p class="travel-page-intro__lede copy-preserve-breaks">{lede}</p>)
	}
</header>

<style>
	.travel-page-intro {
		margin: 0 auto clamp(1.5rem, 4vw, 2.25rem);
		max-width: 52rem;
		text-align: center;
	}

	.travel-page-intro__eyebrow {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.32em;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.travel-page-intro--accent-eyebrow .travel-page-intro__eyebrow {
		letter-spacing: 0.18em;
		color: rgb(92 74 61 / 0.82);
	}

	.travel-page-intro__title {
		margin: 0;
		font-size: clamp(2.125rem, 5.5vw + 1rem, 3rem);
		font-weight: 600;
		line-height: 1.06;
		letter-spacing: -0.02em;
	}

	.travel-page-intro__lede {
		margin: 1.25rem auto 0;
		text-wrap: pretty;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	@media (min-width: 768px) {
		.travel-page-intro__eyebrow {
			font-size: 0.75rem;
		}

		.travel-page-intro--accent-eyebrow .travel-page-intro__eyebrow {
			font-size: 0.8125rem;
		}

		.travel-page-intro__lede {
			font-size: 1.125rem;
		}
	}
</style>
