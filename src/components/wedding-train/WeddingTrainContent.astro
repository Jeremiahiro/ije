---
import ContentCard from "@/components/ContentCard.astro";
import HeroPageSurface from "@/components/HeroPageSurface.astro";
import FormCheck from "@/components/forms/FormCheck.astro";
import FormChoice from "@/components/forms/FormChoice.astro";
import FormChoiceGroup from "@/components/forms/FormChoiceGroup.astro";
import RsvpSection from "@/components/rsvp/RsvpSection.astro";
import WeddingTrainFormField from "@/components/wedding-train/WeddingTrainFormField.astro";
import { WEDDING_TRAIN_FIELD } from "@/util/weddingTrainForm";
import type { WeddingTrainRole } from "@/util/weddingTrainForm";
import {
	TRAD_SCHEDULE,
	CHURCH_SCHEDULE,
	OUTFIT_TIERS,
	ACCOMMODATION_NIGHTS,
	COSTS,
	ACCOUNT,
	PAYMENT_DEADLINE,
	fmtNaira,
} from "@/data/weddingTrain";

interface Props {
	name: string;
	role: WeddingTrainRole;
}

const { name, role } = Astro.props;

const isGroomsman = role === "groomsman" || role === "both";
const isValid = role !== "unknown";

const thankYouWriteChars = ["T", "h", "a", "n", "k", " ", "y", "o", "u"];
const roleItems =
	role === "both"
		? ["Wedding Train — Traditional Marriage", "Groomsman — Church Wedding"]
		: role === "groomsman"
			? ["Groomsman — Church Wedding"]
			: ["Wedding Train — Traditional Marriage"];

const tradTierPrice = (v: string) => {
	if (v === "material_only") return COSTS.tradOutfitMaterial;
	return COSTS.tradOutfitMaterial + COSTS.tradOutfitTailoring;
};

const displayName = name.split(" ")[0]
---

{
	!isValid ? (
		<HeroPageSurface surfaceClass="wt-page" ariaLabelledBy="wt-invalid-heading">
			<ContentCard variant="secondary" class="wt__invalid-card">
				<h1 id="wt-invalid-heading" class="wt__invalid-title">
					Link not recognised
				</h1>
				<p class="wt__invalid-copy">
					This link doesn't appear to be valid. I'm not sure how you got here but you are still invited for the wedding.
				</p>
			</ContentCard>
		</HeroPageSurface>
	) : (
		<HeroPageSurface
			bgSrc="/assets/rsvp.jpg"
			surfaceClass="wt-page"
			ariaLabelledBy="wt-heading"
		>
			<header class="wt__intro">
				<h1 id="wt-heading" class="wt__title">
					{displayName ? `Hello ${displayName}` : "Hello"},
				</h1>
				<p class="wt__lede text-balance">
					Thank you for being someone I value enough to invite to be part
					of one of the most important moments of my life.
				</p>
			</header>

			<!-- Informational sections -->
			<div class="wt__info-sections">
				<div class="wt__ceremony-pair">
				<!-- Traditional Marriage Train -->
				<div class="wt__info-card wt__info-card--with-img">
					<div class="wt__info-img-wrap">
						<img
							class="wt__info-img"
							src="/assets/wedding_t.png"
							alt="Traditional marriage ceremony"
							loading="lazy"
						/>
					</div>
					<div class="wt__info-card-body">
						<h2 class="wt__info-heading">Traditional Marriage Train</h2>
						<div class="wt__event-meta">
							<p class="wt__event-when">
								<strong>Saturday, 2 January 2027</strong>
							</p>
						</div>
						<ol class="wt__schedule">
							{TRAD_SCHEDULE.map(({ time, label, desc }) => (
								<li class="wt__schedule-item">
									<span class="wt__schedule-time">{time}</span>
									<span class="wt__schedule-label">{label}</span>
									{desc && <span class="wt__schedule-desc">{desc}</span>}
								</li>
							))}
						</ol>
						<div class="wt__tiers-block">
							<p class="wt__tiers-name">Traditional outfit</p>
							<div class="wt__outfit-tiers">
								{OUTFIT_TIERS.map(({ label, value }) => (
									<div class="wt__outfit-tier">
										<p class="wt__tier-label">{label}</p>
										<p class="wt__tier-price">
											{fmtNaira(tradTierPrice(value))}
										</p>
									</div>
								))}
							</div>
						</div>
						<div class="wt__tiers-block">
							<p class="wt__tiers-name">Traditional accessories</p>
							<div class="wt__outfit-tiers">
								<div class="wt__outfit-tier">
									<p class="wt__tier-label">Mandatory for all attendees</p>
									<p class="wt__tier-price">{fmtNaira(COSTS.tradOutfitAccessories)}</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Church Wedding (groomsman only) -->
				{isGroomsman && (
					<div class="wt__info-card wt__info-card--with-img">
						<div class="wt__info-img-wrap">
							<img
								class="wt__info-img"
								src="/assets/wedding_c.png"
								alt="Church wedding"
								loading="lazy"
							/>
						</div>
						<div class="wt__info-card-body">
							<h2 class="wt__info-heading">Church Wedding</h2>
							<p class="wt__event-when">
								<strong>Monday, 4 January 2027</strong>
							</p>
							<ol class="wt__schedule">
								{CHURCH_SCHEDULE.map(({ time, label, desc }) => (
									<li class="wt__schedule-item">
										<span class="wt__schedule-time">{time}</span>
										<span class="wt__schedule-label">{label}</span>
										{desc && <span class="wt__schedule-desc">{desc}</span>}
									</li>
								))}
							</ol>
							<div class="wt__tiers-block">
								<p class="wt__tiers-name">Church outfit — Tux</p>
								<div class="wt__outfit-tiers">
									<div class="wt__outfit-tier">
										<p class="wt__tier-label">Made with vendor</p>
										<p class="wt__tier-price">{fmtNaira(COSTS.churchOutfitFull)}</p>
									</div>
								</div>
								<p class="wt__tiers-note">We recommend getting the tuxedo from our vendor so that everything is coordinated and in sync, but you’re welcome to use your own vendor if you prefer.</p>
							</div>
						</div>
					</div>
				)}
				</div>{/* end .wt__ceremony-pair */}

			</div>

			<!-- Form card -->
			<ContentCard variant="secondary" class="wt__form-card">
				<div id="wt-decision-prompt" class="wt__decision-prompt">
					<p class="wt__form-preamble">
						Your presence means far more to me than matching outfits. I
						completely understand if the timing or costs make it difficult
						to participate.
					</p>

					<div class="wt__response-trigger">
						<button
							id="wt-trigger-honour"
							class="wt__trigger-btn wt__trigger-btn--honour"
							type="button"
						>
							I would be honoured to participate
						</button>
						<button
							id="wt-trigger-unable"
							class="wt__trigger-btn wt__trigger-btn--unable"
							type="button"
						>
							I'm unable to commit at this time
						</button>
					</div>
				</div>

				<div id="wt-form-body" class="wt__form-body" hidden>
					<form
						id="wt-form"
						class="wt__form"
						novalidate
						method="post"
						onsubmit="return false"
						data-role={role}
						data-cost-logistics={COSTS.logistics}
						data-cost-accommodation-per-night-min={COSTS.accommodationPerNightMin}
						data-cost-accommodation-per-night-max={COSTS.accommodationPerNightMax}
						data-cost-trad-outfit-material={COSTS.tradOutfitMaterial}
						data-cost-trad-outfit-tailoring={COSTS.tradOutfitTailoring}
						data-cost-church-outfit-full={COSTS.churchOutfitFull}
					data-cost-trad-outfit-accessories={COSTS.tradOutfitAccessories}
					>
						<p
							id="wt-form-summary"
							class="wt__summary"
							role="alert"
							hidden
						/>

						<RsvpSection
							lead
							headingId="wt-personal-heading"
							title="About you"
						>
							<WeddingTrainFormField
								name={WEDDING_TRAIN_FIELD.fullName}
								id="wt-field-full-name"
								label="Full name"
								variant="text"
								autocomplete="name"
								required
								readonly
								value={name}
							/>
							<div class="wt__role-row">
								<p class="wt__role-label">Participating as</p>
								<ul class="wt__role-list">
									{roleItems.map((item) => (
										<li class="wt__role-item">
											<span class="wt__role-check" aria-hidden="true">✓</span>
											{item}
										</li>
									))}
								</ul>
							</div>
							<input
								type="hidden"
								id="wt-input-role"
								name={WEDDING_TRAIN_FIELD.role}
								value={role}
							/>
						</RsvpSection>

						<RsvpSection
							headingId="wt-accommodation-heading"
							title="Accommodation & Logistics"
							lede="Everyone makes their own way to Abia State. The team can arrange your accommodation within Abia for the wedding events — rooms are shared and comes at a cost. Reach out if you'd prefer a private room."
						>
							<FormChoiceGroup
								legend="Accommodation preference"
								errorId={`wt-error-${WEDDING_TRAIN_FIELD.accommodation}`}
							>
								<FormChoice
									name={WEDDING_TRAIN_FIELD.accommodation}
									value="team_arrange"
									required
								>
									Arrange my accommodation
								</FormChoice>
								<FormChoice
									name={WEDDING_TRAIN_FIELD.accommodation}
									value="self_arrange"
								>
									I'll arrange my own accommodation
								</FormChoice>
							</FormChoiceGroup>

							<div id="wt-accommodation-nights" class="wt__acc-nights-sub" hidden>
								<FormChoiceGroup
									legend="How many nights?"
									errorId={`wt-error-${WEDDING_TRAIN_FIELD.accommodationNights}`}
								>
									{ACCOMMODATION_NIGHTS.map(({ label, value, desc, note }) => (
										<FormChoice
											name={WEDDING_TRAIN_FIELD.accommodationNights}
											value={value}
										>
											{label}
											<span class="wt__choice-desc">{desc}</span>
											{note && <span class="wt__choice-note">{note}</span>}
										</FormChoice>
									))}
								</FormChoiceGroup>
							</div>
						</RsvpSection>

						<RsvpSection
							headingId="wt-outfit-heading"
							title="Outfit"
							lede="Let us know your preference and we'll take it from there."
						>
							<FormChoiceGroup
								legend="Outfit preference"
								errorId={`wt-error-${WEDDING_TRAIN_FIELD.outfit}`}
							>
								<FormChoice
									name={WEDDING_TRAIN_FIELD.outfit}
									value="team_organises"
									required
								>
									Please source my outfit
								</FormChoice>
								<FormChoice
									name={WEDDING_TRAIN_FIELD.outfit}
									value="self_source"
								>
									I'll source my own outfit
								</FormChoice>
							</FormChoiceGroup>

							{isGroomsman && (
								<div id="wt-outfit-scope" class="wt__outfit-scope-sub" hidden>
									<FormChoiceGroup
										legend="Which outfit(s)?"
										errorId={`wt-error-${WEDDING_TRAIN_FIELD.outfitScope}`}
									>
										<FormChoice
											name={WEDDING_TRAIN_FIELD.outfitScope}
											value="both"
										>
											Both (Traditional &amp; Church)
										</FormChoice>
										<FormChoice
											name={WEDDING_TRAIN_FIELD.outfitScope}
											value="trad_only"
										>
											Traditional only
										</FormChoice>
										<FormChoice
											name={WEDDING_TRAIN_FIELD.outfitScope}
											value="church_only"
										>
											Church only
										</FormChoice>
									</FormChoiceGroup>
								</div>
							)}

							<div id="wt-outfit-self-source" class="wt__outfit-self-sub" hidden>
								<FormCheck
									id="wt-check-outfit-self-confirm"
									name={WEDDING_TRAIN_FIELD.outfitSelfConfirm}
								>
									I confirm I will follow the outfit guidelines provided
								</FormCheck>
								<p id={`wt-error-${WEDDING_TRAIN_FIELD.outfitSelfConfirm}`} class="wt__self-confirm-error" hidden />
							</div>

							<div id="wt-outfit-tier" class="wt__outfit-tier-sub" hidden>
								<FormChoiceGroup
									legend="Traditional outfit — service level"
									errorId={`wt-error-${WEDDING_TRAIN_FIELD.outfitTier}`}
								>
									{OUTFIT_TIERS.map(({ label, value }) => (
										<FormChoice
											name={WEDDING_TRAIN_FIELD.outfitTier}
											value={value}
										>
											{label}
										</FormChoice>
									))}
								</FormChoiceGroup>
							</div>
						</RsvpSection>

						<RsvpSection
							headingId="wt-commitments-heading"
							title="Commitments"
							lede="Please confirm the following."
						>
							<div class="wt__checkbox-stack">
								<FormCheck
									id="wt-check-commit-attend"
									name={WEDDING_TRAIN_FIELD.commitAttend}
									required
								>
									I understand the commitment involved and will be available.
								</FormCheck>
								<p id={`wt-error-${WEDDING_TRAIN_FIELD.commitAttend}`} class="wt__commit-error" hidden />
								<FormCheck
									id="wt-check-commit-outfit"
									name={WEDDING_TRAIN_FIELD.commitOutfit}
									required
								>
									I agree to wear the agreed outfit or follow the provided guidelines.
								</FormCheck>
								<p id={`wt-error-${WEDDING_TRAIN_FIELD.commitOutfit}`} class="wt__commit-error" hidden />
								<FormCheck
									id="wt-check-commit-travel"
									name={WEDDING_TRAIN_FIELD.commitTravel}
									required
								>
									I understand I am responsible for making my own way to Abia State.
								</FormCheck>
								<p id={`wt-error-${WEDDING_TRAIN_FIELD.commitTravel}`} class="wt__commit-error" hidden />
								<FormCheck
									id="wt-check-commit-contact"
									name={WEDDING_TRAIN_FIELD.commitContact}
									required
								>
									I understand that any costs I select above are my responsibility.
								</FormCheck>
								<p id={`wt-error-${WEDDING_TRAIN_FIELD.commitContact}`} class="wt__commit-error" hidden />
								{isGroomsman && (
									<>
										<FormCheck
											id="wt-check-commit-church"
											name={WEDDING_TRAIN_FIELD.commitChurch}
											required
										>
											I understand my role extends to the church wedding on 4 January 2027.
										</FormCheck>
										<p id={`wt-error-${WEDDING_TRAIN_FIELD.commitChurch}`} class="wt__commit-error" hidden />
									</>
								)}
							</div>
						</RsvpSection>

						<input
							type="hidden"
							name={WEDDING_TRAIN_FIELD.finalDecision}
							value="honoured"
						/>

						<div id="wt-cost-summary" class="wt__cost-summary" hidden>
							<p class="wt__cost-summary-title">Cost summary</p>
							<table class="wt__cost-table">
								<tbody id="wt-cost-rows"></tbody>
								<tfoot>
									<tr class="wt__cost-total-row">
										<td>Amount due now</td>
										<td id="wt-cost-total" class="wt__cost-total-value">₦—</td>
									</tr>
								</tfoot>
							</table>
							<div class="wt__account">
								<p class="wt__account-heading">Payment details</p>
								<div class="wt__account-lines">
									<div class="wt__account-line">
										<span class="wt__account-line-label">Bank</span>
										<span class="wt__account-line-value">{ACCOUNT.bank}</span>
									</div>
									<div class="wt__account-line">
										<span class="wt__account-line-label">Account name</span>
										<span class="wt__account-line-value">{ACCOUNT.name}</span>
									</div>
									<div class="wt__account-line">
										<span class="wt__account-line-label">Account number</span>
										<span class="wt__account-line-value wt__account-number">{ACCOUNT.number}</span>
									</div>
								</div>
								<p class="wt__payment-deadline">
									Payment due on or before {PAYMENT_DEADLINE}
								</p>
							</div>
						</div>

						<div class="wt__actions">
							<button
								type="submit"
								class="wt__submit"
								id="wt-submit"
							>
								Submit
							</button>
						</div>
					</form>
				</div>

				<div
					id="wt-success"
					class="wt__success"
					hidden
					role="status"
					aria-live="polite"
					tabindex="-1"
				>
					<p class="wt__success-title">
						<span class="wt__sr-only">Thank you</span>
						<span class="wt__success-write" aria-hidden="true">
							{
								thankYouWriteChars.map((ch, i) => (
									<span
										class="wt__success-write-char"
										style={`--write-i: ${i}`}
									>
										{ch}
									</span>
								))
							}
						</span>
					</p>
					<p id="wt-success-copy-honour" class="wt__success-copy">
						Your response is in — I can't wait to have you there.
					</p>
					<p id="wt-success-copy-unable" class="wt__success-copy" hidden>
						I completely understand. Thank you for taking the time to let
						me know — I hope to see you very soon.
					</p>
					<div id="wt-success-honour-details" class="wt__success-honour-details">
						<p id="wt-success-measurement" class="wt__success-measurement" hidden>
							We'll be in touch to collect your measurements — please respond promptly when we reach out.
						</p>
						<div class="wt__account wt__success-payment">
							<p class="wt__account-heading">Payment details</p>
							<div class="wt__account-lines">
								<div class="wt__account-line">
									<span class="wt__account-line-label">Bank</span>
									<span class="wt__account-line-value">{ACCOUNT.bank}</span>
								</div>
								<div class="wt__account-line">
									<span class="wt__account-line-label">Account name</span>
									<span class="wt__account-line-value">{ACCOUNT.name}</span>
								</div>
								<div class="wt__account-line">
									<span class="wt__account-line-label">Account number</span>
									<span class="wt__account-line-value wt__account-number">{ACCOUNT.number}</span>
								</div>
							</div>
							<p class="wt__payment-deadline">
								Payment due on or before {PAYMENT_DEADLINE}
							</p>
						</div>
						<div class="wt__itinerary">
							<p class="wt__account-heading">Itinerary</p>
							<div class="wt__itinerary-day">
								<p class="wt__itinerary-date">Saturday, 2 January — Traditional Marriage</p>
								<ol class="wt__itinerary-list">
									{TRAD_SCHEDULE.map(({ time, label, desc }) => (
										<li>
											<span class="wt__itinerary-time">{time}</span>
											<span>
												{label}
												{desc && <span class="wt__itinerary-note"> — {desc}</span>}
											</span>
										</li>
									))}
								</ol>
							</div>
							{isGroomsman && (
								<div class="wt__itinerary-day">
									<p class="wt__itinerary-date">Monday, 4 January — Church Wedding</p>
									<ol class="wt__itinerary-list">
										<li class="wt__itinerary-item--optional">
											<span class="wt__itinerary-time">~5:00am</span>
											<span>
												5k morning run
												<span class="wt__itinerary-note"> — optional</span>
											</span>
										</li>
										{CHURCH_SCHEDULE.map(({ time, label, desc }) => (
											<li>
												<span class="wt__itinerary-time">{time}</span>
												<span>
													{label}
													{desc && <span class="wt__itinerary-note"> — {desc}</span>}
												</span>
											</li>
										))}
									</ol>
								</div>
							)}
						</div>
					</div>
				</div>
			</ContentCard>
		</HeroPageSurface>
	)
}

<style>
	/* ── Invalid state ─────────────────────────────────────────────── */
	.wt__invalid-card {
		max-width: min(40rem, 100%);
		margin-inline: auto;
		margin-block: auto;
		text-align: center;
	}

	.wt__invalid-title {
		margin: 0 0 0.75rem;
		font-size: clamp(1.35rem, 3.5vw, 1.75rem);
		font-weight: 800;
		color: #4a3d32;
	}

	.wt__invalid-copy {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--text-muted);
	}

	/* ── Page intro ────────────────────────────────────────────────── */
	.wt__intro {
		margin: 0 auto clamp(1.75rem, 5vw, 2.75rem);
		max-width: 44rem;
		text-align: center;
	}

	.wt__title {
		margin: 0 0 0.65rem;
		font-size: clamp(2.5rem, 6vw, 3.75rem);
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.01em;
		color: #4a3d32;
	}

	.wt__lede {
		margin: 0 auto;
		font-size: clamp(1rem, 2.25vw, 1.1rem);
		line-height: 1.65;
		color: var(--text-muted);
		max-width: 36rem;
	}

	/* ── Info sections ─────────────────────────────────────────────── */
	.wt__info-sections {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 3vw, 1.5rem);
		width: 100%;
		max-width: min(72rem, 100%);
		margin-inline: auto;
		margin-bottom: clamp(1.5rem, 4vw, 2.25rem);
	}

	.wt__ceremony-pair {
		display: flex;
		flex-direction: column;
		gap: clamp(1rem, 3vw, 1.5rem);
	}

	@media (min-width: 680px) {
		.wt__ceremony-pair {
			flex-direction: row;
			align-items: stretch;
			justify-content: center;
		}

		.wt__ceremony-pair > * {
			flex: 1 1 0;
			min-width: 0;
			max-width: 36rem;
		}
	}

	.wt__info-card {
		box-sizing: border-box;
		border-radius: clamp(1rem, 2.5vw, 1.5rem);
		border: 1px solid rgb(255 255 255 / 0.55);
		background: rgb(255 255 255 / 0.28);
		box-shadow: 0 8px 28px rgb(110 82 60 / 0.08);
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		padding: clamp(1.15rem, 3.5vw, 1.75rem);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.wt__info-card--with-img {
		padding: 0;
		overflow: hidden;
	}

	.wt__info-img-wrap {
		width: 100%;
		overflow: hidden;
		height: clamp(700px, 30vw, 280px);
	}

	.wt__info-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.wt__info-card-body {
		padding: clamp(1.15rem, 3.5vw, 1.75rem);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.wt__info-heading {
		margin: 0;
		font-size: clamp(1.1rem, 2.5vw, 1.3rem);
		font-weight: 800;
		letter-spacing: 0.01em;
		color: #4a3d32;
	}

	.wt__info-copy {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text-muted);
	}

	/* ── Event meta (date + venue) ─────────────────────────────────── */
	.wt__event-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.wt__event-when {
		margin: 0;
		font-size: 1rem;
		color: #4a3d32;
	}

	.wt__event-where {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	/* ── Church wedding schedule ───────────────────────────────────── */
	.wt__schedule {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.wt__schedule-item {
		display: grid;
		grid-template-columns: 4rem 1fr;
		grid-template-rows: auto auto;
		column-gap: 0.65rem;
		row-gap: 0.2rem;
	}

	.wt__schedule-time {
		grid-row: 1 / 3;
		align-self: start;
		font-size: 0.82rem;
		font-weight: 700;
		color: #6e523c;
		padding-top: 0.12rem;
	}

	.wt__schedule-label {
		font-size: 0.95rem;
		font-weight: 600;
		color: #4a3d32;
		line-height: 1.3;
	}

	.wt__schedule-desc {
		font-size: 0.84rem;
		line-height: 1.45;
		color: var(--text-muted);
	}

	/* ── Cost block ────────────────────────────────────────────────── */
	.wt__cost-block {
		padding: 0.85rem 1rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(201 168 124 / 0.4);
		background: linear-gradient(
			135deg,
			rgb(255 251 243 / 0.92) 0%,
			rgb(245 232 214 / 0.4) 100%
		);
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.wt__cost-label {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.wt__cost-value {
		margin: 0;
		font-size: 1.1rem;
		font-weight: 700;
		color: #4a3d32;
	}

	.wt__cost-includes {
		margin: 0.15rem 0 0;
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--text-muted);
	}

	/* ── Outfit tiers (in each ceremony card) ─────────────────────── */
	.wt__tiers-block {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.wt__tiers-name {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.wt__outfit-tiers {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.55rem;
	}

	.wt__outfit-tier {
		padding: 0.6rem 0.75rem;
		border-radius: 0.5rem;
		background: rgb(255 255 255 / 0.6);
		border: 1px solid rgb(201 168 124 / 0.3);
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.wt__tier-label {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.wt__tier-price {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		color: #4a3d32;
	}

	.wt__account {
		border-top: 1px solid rgb(201 168 124 / 0.35);
		padding-top: 0.75rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
	}

	.wt__account-heading {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #6e523c;
		text-align: center;
	}

	.wt__account-lines {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.wt__account-line {
		display: flex;
		gap: 0.65rem;
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.wt__account-line-label {
		color: var(--text-muted);
		min-width: 8rem;
		flex-shrink: 0;
	}

	.wt__account-line-value {
		font-weight: 600;
		color: #4a3d32;
	}

	.wt__account-number {
		font-family: ui-monospace, "Cascadia Code", "Source Code Pro", Menlo, monospace;
		font-size: 0.95rem;
		letter-spacing: 0.06em;
	}

	.wt__payment-deadline {
		margin: 0;
		font-size: 0.825rem;
		color: var(--text-muted);
		font-style: italic;
		text-align: center;
	}

	/* ── Commitment errors ─────────────────────────────────────────── */
	.wt__commit-error {
		margin: -0.3rem 0 0 1.95rem;
		font-size: 0.82rem;
		font-weight: 600;
		color: #b54a3a;
	}

	.wt__commit-error[hidden] {
		display: none !important;
	}

	/* ── Form card ─────────────────────────────────────────────────── */
	.wt__form-card {
		width: 100%;
		max-width: min(48rem, 100%);
		margin-inline: auto;
	}

	.wt__form-preamble {
		margin: 0;
		padding: 1rem 1.1rem;
		border-radius: 0.75rem;
		border: 1px solid rgb(201 168 124 / 0.4);
		background: linear-gradient(
			135deg,
			rgb(255 251 243 / 0.95) 0%,
			rgb(245 232 214 / 0.45) 100%
		);
		font-size: 0.95rem;
		line-height: 1.55;
		color: #4a3d32;
		font-style: italic;
		text-align: center;
	}

	/* ── Accommodation nights sub-group ───────────────────────────── */
	.wt__acc-nights-sub {
		margin-top: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(201 168 124 / 0.35);
		background: rgb(255 255 255 / 0.4);
	}

	.wt__acc-nights-sub[hidden] {
		display: none !important;
	}

	/* ── Choice descriptions & notes ──────────────────────────────── */
	.wt__choice-desc {
		display: block;
		margin-top: 0.15rem;
		font-size: 0.8rem;
		font-weight: 400;
		font-style: italic;
		color: var(--text-muted);
		line-height: 1.4;
	}

	.wt__choice-note {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.78rem;
		font-weight: 400;
		font-style: normal;
		color: #6e523c;
		line-height: 1.4;
		padding: 0.3rem 0.5rem;
		border-radius: 0.35rem;
		background: rgb(201 168 124 / 0.15);
		border-left: 2px solid rgb(201 168 124 / 0.6);
	}

	/* ── Scope & self-source sub-groups ──────────────────────────── */
	.wt__outfit-scope-sub,
	.wt__outfit-self-sub {
		margin-top: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(201 168 124 / 0.35);
		background: rgb(255 255 255 / 0.4);
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.wt__outfit-scope-sub[hidden],
	.wt__outfit-self-sub[hidden] {
		display: none !important;
	}

	.wt__self-confirm-error {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: #b54a3a;
	}

	.wt__self-confirm-error[hidden] {
		display: none !important;
	}

	/* ── Outfit tier sub-group ────────────────────────────────────── */
	.wt__outfit-tier-sub {
		margin-top: 0.75rem;
		padding: 0.85rem 1rem;
		border-radius: 0.65rem;
		border: 1px solid rgb(201 168 124 / 0.35);
		background: rgb(255 255 255 / 0.4);
	}

	.wt__outfit-tier-sub[hidden] {
		display: none !important;
	}

	/* ── Cost summary ──────────────────────────────────────────────── */
	.wt__cost-summary {
		padding: 1rem 1.1rem;
		border-radius: 0.75rem;
		border: 1px solid rgb(201 168 124 / 0.4);
		background: linear-gradient(
			135deg,
			rgb(255 251 243 / 0.95) 0%,
			rgb(245 232 214 / 0.45) 100%
		);
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.wt__cost-summary[hidden] {
		display: none !important;
	}

	.wt__cost-summary-title {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: #6e523c;
	}

	/* ── Cost table ────────────────────────────────────────────────── */
	.wt__cost-table {
		width: 100%;
		border-collapse: collapse;
	}

	.wt__cost-table :global(.wt__cost-row) td,
	.wt__cost-table :global(.wt__cost-sub-row) td,
	.wt__cost-total-row td {
		padding: 0;
		vertical-align: baseline;
	}

	.wt__cost-table :global(.wt__cost-row) {
		font-size: 0.9rem;
	}

	.wt__cost-table :global(.wt__cost-row-label) {
		color: var(--text-muted);
		padding-block: 0.3rem;
		width: 100%;
	}

	.wt__cost-table :global(.wt__cost-row-amount) {
		font-weight: 600;
		color: #4a3d32;
		white-space: nowrap;
		padding-left: 1rem;
		text-align: right;
	}

	.wt__cost-table :global(.wt__cost-sub-row) {
		font-size: 0.82rem;
	}

	.wt__cost-table :global(.wt__cost-sub-label) {
		color: var(--text-muted);
		font-style: italic;
		padding-inline-start: 1rem;
		padding-block-end: 0.25rem;
	}

	.wt__cost-table :global(.wt__cost-sub-amount) {
		color: var(--text-muted);
		white-space: nowrap;
		padding-left: 1rem;
		text-align: right;
		font-style: italic;
	}

	.wt__cost-total-row {
		font-size: 0.95rem;
		font-weight: 700;
		color: #4a3d32;
		border-top: 1px solid rgb(201 168 124 / 0.45);
	}

	.wt__cost-total-row td {
		padding-top: 0.55rem !important;
	}

	.wt__cost-total-value {
		font-size: 1.1rem;
		text-align: right;
		white-space: nowrap;
		padding-left: 1rem;
	}

	:global(.wt__cost-tbc) {
		color: var(--text-muted);
		font-style: italic;
		font-weight: 500;
	}

	/* ── Response trigger ──────────────────────────────────────────── */
	.wt__decision-prompt {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		width: 100%;
	}

	.wt__decision-prompt[hidden] {
		display: none !important;
	}

	.wt__response-trigger {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		width: 100%;
		max-width: 24rem;
	}

	.wt__trigger-btn {
		padding: 0.72rem 1.75rem;
		min-height: 3.1rem;
		border-radius: 0.55rem;
		border: 1px solid rgb(110 82 60 / 0.35);
		font-weight: 700;
		font-size: 1.02rem;
		cursor: pointer;
		font-family: inherit;
		transition: filter 0.15s ease;
	}

	.wt__trigger-btn--honour {
		background: linear-gradient(180deg, #6e523c 0%, #5a4434 100%);
		color: #fffcf7;
	}

	.wt__trigger-btn--unable {
		background: transparent;
		color: #5a4434;
		border-color: rgb(110 82 60 / 0.3);
	}

	.wt__trigger-btn:hover {
		filter: brightness(1.06);
	}

	.wt__trigger-btn--unable:hover {
		filter: none;
		background: rgb(110 82 60 / 0.06);
	}

	/* ── Form body ─────────────────────────────────────────────────── */
	.wt__form-body {
		display: flex;
		flex-direction: column;
	}

	.wt__form-body[hidden] {
		display: none !important;
	}

	.wt__form {
		display: flex;
		flex-direction: column;
		--wt-form-stack-gap: 2.35rem;
		gap: var(--wt-form-stack-gap);
	}

	.wt__summary {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.45;
		color: #b54a3a;
	}

	.wt__summary:not([hidden]) {
		padding: 0.75rem 1rem;
		border-radius: 0.6rem;
		border: 1px solid rgb(181 74 58 / 0.35);
		background: rgb(181 74 58 / 0.07);
		font-weight: 600;
	}

	.wt__summary[hidden] {
		display: none !important;
	}

	/* ── About you section ─────────────────────────────────────────── */
	.wt__role-row {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.wt__role-label {
		margin: 0;
		font-size: 0.84rem;
		font-weight: 600;
		color: #4a3d32;
	}

	.wt__role-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.wt__role-item {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-muted);
		font-style: italic;
	}

	.wt__role-check {
		font-style: normal;
		font-weight: 700;
		color: #6e523c;
		flex-shrink: 0;
	}

	/* ── Commitments ───────────────────────────────────────────────── */
	.wt__checkbox-stack {
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	/* ── Actions ───────────────────────────────────────────────────── */
	.wt__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.wt__submit {
		padding: 0.72rem 1.5rem;
		min-height: 3.1rem;
		border-radius: 0.55rem;
		border: 1px solid rgb(110 82 60 / 0.35);
		background: linear-gradient(180deg, #6e523c 0%, #5a4434 100%);
		color: #fffcf7;
		font-weight: 700;
		font-size: 1.02rem;
		cursor: pointer;
		font-family: inherit;
	}

	.wt__submit:hover:not(:disabled) {
		filter: brightness(1.06);
	}

	.wt__submit:disabled {
		opacity: 0.65;
		cursor: not-allowed;
	}

	/* ── Success state ─────────────────────────────────────────────── */
	.wt__success {
		text-align: center;
		padding-block: 0.75rem;
		max-width: 34rem;
		margin-inline: auto;
		scroll-margin-top: max(
			4rem,
			calc(var(--site-header-height) + env(safe-area-inset-top, 0px) + 4.5rem)
		);
	}

	.wt__success[hidden] {
		display: none !important;
	}

	.wt__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	.wt__success-title {
		position: relative;
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		min-height: 1.85em;
		margin: 0 0 0.4rem;
		font-weight: 800;
		color: #5a7d4a;
		line-height: 1.2;
		text-shadow:
			0 1px 2px rgb(255 252 247 / 0.95),
			0 0 18px rgb(255 252 247 / 0.55);
	}

	.wt__success-write {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		font-family: inherit;
		font-weight: inherit;
		font-size: clamp(1.35rem, 4.25vw, 1.85rem);
		letter-spacing: 0.02em;
	}

	.wt__success-write-char {
		display: inline-block;
		opacity: 1;
		transform-origin: bottom left;
	}

	@keyframes wt-success-write {
		0% {
			opacity: 0;
			transform: translate(0.2em, 0.06em) rotate(-5deg);
		}

		14% {
			opacity: 1;
			transform: translate(0, 0) rotate(0deg);
		}

		52% {
			opacity: 1;
			transform: translate(0, 0) rotate(0deg);
		}

		72% {
			opacity: 0;
			transform: translate(0.2em, 0.06em) rotate(-5deg);
		}

		100% {
			opacity: 0;
			transform: translate(0.2em, 0.06em) rotate(-5deg);
		}
	}

	:global(.content-card--secondary.wt__form-card):has(#wt-success:not([hidden])) {
		flex: 1;
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: rgb(255 255 255 / 0.11);
		border-color: rgb(255 255 255 / 0.36);
		box-shadow: 0 14px 40px rgb(110 82 60 / 0.07);
		-webkit-backdrop-filter: blur(1px);
		backdrop-filter: blur(1px);

		& #wt-success {
			flex: 1;
			display: flex;
			flex-direction: column;
			justify-content: center;
			min-height: 0;
		}

		& .wt__success-write-char {
			animation: wt-success-write 2.65s cubic-bezier(0.2, 0.82, 0.28, 1) infinite;
			animation-delay: calc(var(--write-i, 0) * 0.058s);
		}

		& .wt__success-copy {
			text-shadow:
				0 1px 2px rgb(255 252 247 / 0.9),
				0 0 14px rgb(255 252 247 / 0.42);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.content-card--secondary.wt__form-card):has(#wt-success:not([hidden])) {
			& .wt__success-write-char {
				opacity: 1;
				animation: none;
				transform: none;
			}
		}
	}

	.wt__success-copy {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.wt__success-honour-details {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
	}

	.wt__success-payment {
		margin-top: 0;
	}

	.wt__itinerary {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.wt__itinerary-day {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.wt__itinerary-date {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
	}

	.wt__itinerary-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.wt__itinerary-list li {
		display: flex;
		gap: 0.75rem;
		font-size: 0.9rem;
		line-height: 1.4;
	}

	.wt__itinerary-time {
		flex-shrink: 0;
		width: 5rem;
		font-variant-numeric: tabular-nums;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.wt__itinerary-note {
		color: var(--text-muted);
		font-size: 0.85em;
	}

	.wt__itinerary-item--optional {
		opacity: 0.6;
		font-style: italic;
	}

	.wt__tiers-note {
		margin: 0;
		font-size: 0.8rem;
		font-style: italic;
		color: var(--text-muted);
	}

	.wt__success-measurement {
		padding: 0.75rem 1rem;
		border-radius: 0.6rem;
		border: 1px solid rgb(201 168 124 / 0.4);
		background: linear-gradient(135deg, rgb(255 251 243 / 0.95) 0%, rgb(245 232 214 / 0.45) 100%);
		font-size: 0.88rem;
		line-height: 1.5;
		color: #4a3d32;
		font-style: italic;
	}

	.wt__success-measurement[hidden] {
		display: none !important;
	}

	:global(.wt-page.hero-page) {
		overflow-x: visible;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}

	:global(.wt-page.hero-page .hero-page__shell) {
		flex: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 0;
		box-sizing: border-box;
