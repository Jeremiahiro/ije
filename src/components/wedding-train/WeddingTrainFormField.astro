---
import FormField from "@/components/forms/FormField.astro";
import type { FormFieldVariant } from "@/components/forms/FormField.astro";

interface Props {
	name: string;
	id: string;
	label: string;
	variant: FormFieldVariant;
	optional?: boolean;
	hint?: string;
	class?: string;
	rows?: number;
	value?: string;
	autocomplete?: string;
	required?: boolean;
	placeholder?: string;
	readonly?: boolean;
}

const props = Astro.props;
---

<FormField {...props} errorId={`wt-error-${props.name}`} />
