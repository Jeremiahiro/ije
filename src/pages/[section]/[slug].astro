---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ComingSoon from "@/components/ComingSoon.astro";
import {
	defaultPageDescription,
	hasDedicatedSublinkPage,
	navHref,
	navItems,
	siteTitleSuffix,
} from "@/data/site-nav";

interface Props {
	pageTitle: string;
	pageDescription?: string;
}

export function getStaticPaths() {
	const paths: Array<{
		params: { section: string; slug: string };
		props: Props;
	}> = [];

	for (const item of navItems) {
		if (item.kind !== "sublinks") continue;
		const section = item.path.replace(/^\//, "");
		for (const s of item.sublinks) {
			if (hasDedicatedSublinkPage(section, s.slug)) continue;
			paths.push({
				params: { section, slug: s.slug },
				props: {
					pageTitle: s.title,
					pageDescription: s.description,
				},
			});
		}
	}

	return paths;
}

const { section, slug } = Astro.params;
const { pageTitle, pageDescription } = Astro.props;

const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalPath = navHref(`/${section}`, slug!);
const canonicalHref = new URL(canonicalPath, Astro.url.origin).href;
---

<BaseLayout
	title={title}
	description={pageDescription ?? defaultPageDescription}
	canonicalHref={canonicalHref}
	htmlClass="coming-soon-page"
>
	<ComingSoon heading={pageTitle} subheading={pageDescription} />
</BaseLayout>
