---
import AboutFaqContent from "@/components/about/AboutFaqContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { navHref, siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "FAQ";
const description =
	"Short answers to common questions about Jane & Jeremiah’s wedding in Nigeria, including travel, dress code, guest details, and registry guidance.";
const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalHref = new URL(navHref("/about", "faq"), Astro.url.origin).href;
---

<BaseLayout title={title} description={description} canonicalHref={canonicalHref}>
	<AboutFaqContent />
</BaseLayout>
