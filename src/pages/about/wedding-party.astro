---
import AboutWeddingPartyContent from "@/components/about/AboutWeddingPartyContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { navHref, siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "Wedding Party";
const description =
	"A celebration with music, dancing, and joyful vibes after Jane & Jeremiah's wedding reception.";
const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalHref = new URL(navHref("/about", "wedding-party"), Astro.url.origin).href;
---

<BaseLayout title={title} description={description} canonicalHref={canonicalHref}>
	<AboutWeddingPartyContent />
</BaseLayout>
