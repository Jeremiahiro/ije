---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ComingSoon from "@/components/ComingSoon.astro";
import { defaultPageDescription, siteTitleSuffix } from "@/data/site-nav";

const title = `Asoebi · ${siteTitleSuffix}`;
const canonicalHref = new URL("/asoebi", Astro.url.origin).href;
---

<BaseLayout
	title={title}
	description={defaultPageDescription}
	canonicalHref={canonicalHref}
	htmlClass="coming-soon-page"
>
	<ComingSoon
		heading="Asoebi"
		subheading="Asoebi details are coming soon. Please check back for fabric colors, and styles."
	/>
</BaseLayout>
