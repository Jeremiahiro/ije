---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AsoEbiContent from "@/components/asoebi/AsoEbiContent.astro";
import { siteTitleSuffix } from "@/data/site-nav";

const title = `Asoebi · ${siteTitleSuffix}`;
const description =
  "Asoebi colors of the day and package options for Jane & Jeremiah’s wedding. Get in touch for payment instructions and pickup contact.";
const canonicalHref = new URL("/asoebi", Astro.url.origin).href;

---

<BaseLayout
  title={title}
  description={description}
  canonicalHref={canonicalHref}
>
  <AsoEbiContent />
</BaseLayout>
