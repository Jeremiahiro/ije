---
import FaqContent from "@/components/faq/FaqContent.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { coupleNames } from "@/config/event";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "FAQ";
const description =
	`Short answers to common questions about ${coupleNames}’s wedding in Nigeria, including travel, dress code, guest details, and registry guidance.`;
const title = `${pageTitle} · ${siteTitleSuffix}`;
const canonicalHref = new URL("/faq", Astro.url.origin).href;
---

<BaseLayout title={title} description={description} canonicalHref={canonicalHref}>
	<FaqContent />
</BaseLayout>
