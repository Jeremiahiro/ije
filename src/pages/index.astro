---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ComingSoon from "@/components/ComingSoon.astro";
import { defaultPageDescription, siteTitleSuffix } from "@/data/site-nav";

const title = `Coming soon · ${siteTitleSuffix}`;
---

<BaseLayout title={title} description={defaultPageDescription} htmlClass="coming-soon-page">
	<ComingSoon heading="Coming soon" />
</BaseLayout>
