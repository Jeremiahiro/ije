---
export const prerender = false;

import BaseLayout from "@/layouts/BaseLayout.astro";
import WeddingTrainContent from "@/components/wedding-train/WeddingTrainContent.astro";
import { siteTitleSuffix } from "@/data/site-nav";
import type { WeddingTrainRole } from "@/util/weddingTrainForm";

const parseNames = (raw: string): string[] =>
	raw
		.split(",")
		.map((n) => n.trim())
		.filter(Boolean);

const trainNames = parseNames(import.meta.env.TRAIN_NAMES ?? "");
const groomsmenNames = parseNames(import.meta.env.GROOMSMEN_NAMES ?? "");

const w = Astro.url.searchParams.get("n")?.trim() ?? "";

// Normalize: collapse hyphens to spaces so "james-doe" matches "James Doe"
const normalize = (s: string) =>
	s.replace(/-/g, " ").replace(/\s+/g, " ").trim().toLowerCase();
const wNorm = normalize(w);

const inTrain = wNorm.length > 0 && trainNames.some((n) => normalize(n) === wNorm);
const inGroomsmen = wNorm.length > 0 && groomsmenNames.some((n) => normalize(n) === wNorm);

const role: WeddingTrainRole = inGroomsmen ? "groomsman" : inTrain ? "train" : "unknown";

const toTitleCase = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());

const allNames = [...trainNames, ...groomsmenNames];
const matchedName = allNames.find((n) => normalize(n) === wNorm);
const displayName = toTitleCase((matchedName ?? w).replace(/-/g, " ").trim());

const title = `Join the Wedding Train · ${siteTitleSuffix}`;
const description =
	"Joining details for the wedding train — Jane & Jeremiah's wedding, January 2027.";
---

<BaseLayout title={title} description={description}>
	<WeddingTrainContent name={displayName} role={role} />
	<script>
		import { mountWeddingTrainPage } from "@/components/wedding-train/WeddingTrainForm.script";

		mountWeddingTrainPage();
	</script>
</BaseLayout>
