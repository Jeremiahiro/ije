---
import LaunchNotifyForm from "@/components/LaunchNotifyForm.astro";

const coupleNames = "Jane and Jeremiah";
const rsvpDeadlineLabel = "October 1, 2026";
const locationTeaser = "January 2027 · Abia State, Nigeria";

const traditionalDateLong = "Saturday, 2 January 2027";
const whiteWeddingDateLong = "Monday, 4 January 2027";
/**
 * Countdown to traditional marriage (local midnight in the visitor’s timezone).
 * Switch to a fixed Nigeria offset if you need a single instant worldwide.
 */
const countdownTargetIso = "2027-01-02T00:00:00";

const title = `${coupleNames} · Save the date`;
const description = `${coupleNames} are getting married. Traditional marriage on 2 January 2027 and white wedding on 4 January 2027. ${locationTeaser}. RSVP by ${rsvpDeadlineLabel}.`;
const canonicalHref = Astro.url.href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalHref} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalHref} />
	</head>
	<body>
		<div class="save-page">
			<div class="save-page__bg-wrap" aria-hidden="true">
				<div class="save-page__bg"></div>
			</div>
			<div class="save-page__veil" aria-hidden="true"></div>

			<div class="save-page__inner">
				<header class="save-header">
					<p class="save-kicker">{coupleNames}</p>
					<h1 class="save-title">Save the date</h1>
					<p class="save-teaser">{locationTeaser}</p>
					<ul class="save-dates">
						<li>
							<span class="save-dates__kind">Traditional marriage</span>
							<time datetime="2027-01-02">{traditionalDateLong}</time>
						</li>
						<li>
							<span class="save-dates__kind">White wedding</span>
							<time datetime="2027-01-04">{whiteWeddingDateLong}</time>
						</li>
					</ul>
				</header>

				<main class="save-main">
					<p class="save-rsvp">
						RSVP by <time datetime="2026-10-01">{rsvpDeadlineLabel}</time>
					</p>

					<section
						class="save-countdown"
						id="countdown-root"
						data-target={countdownTargetIso}
						aria-label="Countdown to traditional marriage"
					>
						<p class="save-countdown__label">Traditional marriage</p>
						<p class="save-countdown__date">{traditionalDateLong}</p>
						<p class="save-countdown__live" id="countdown-live" hidden></p>
					</section>

					<p class="save-footnote">Details to follow.</p>
					<LaunchNotifyForm />
				</main>
			</div>
		</div>

		<script is:inline>
			(function () {
				var root = document.getElementById("countdown-root");
				var live = document.getElementById("countdown-live");
				if (!root || !live) return;

				var raw = root.getAttribute("data-target");
				if (!raw) return;

				var end = Date.parse(raw);
				if (Number.isNaN(end)) return;

				function formatDiff(ms) {
					if (ms <= 0) return "The celebrations are here!";
					var sec = Math.floor(ms / 1000);
					var d = Math.floor(sec / 86400);
					sec -= d * 86400;
					var h = Math.floor(sec / 3600);
					sec -= h * 3600;
					var m = Math.floor(sec / 60);
					sec -= m * 60;
					var parts = [];
					if (d) parts.push(d + " day" + (d === 1 ? "" : "s"));
					if (d || h) parts.push(h + " hour" + (h === 1 ? "" : "s"));
					if (d || h || m) parts.push(m + " minute" + (m === 1 ? "" : "s"));
					parts.push(sec + " second" + (sec === 1 ? "" : "s"));
					return parts.join(", ") + " to go";
				}

				function tick() {
					var now = Date.now();
					live.textContent = formatDiff(end - now);
					live.hidden = false;
				}

				tick();
				setInterval(tick, 1000);
			})();
		</script>

		<style is:global>
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}

			html,
			body {
				margin: 0;
				min-height: 100%;
				overflow-x: clip;
			}

			body {
				font-family:
					system-ui,
					-apple-system,
					Segoe UI,
					Roboto,
					Helvetica,
					Arial,
					sans-serif;
				color: #faf6ef;
			}
		</style>

		<style>
			.save-page {
				position: relative;
				isolation: isolate;
				min-height: 100dvh;
				width: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: clamp(1.25rem, 5vw, 3rem);
				overflow-x: clip;
			}

			.save-page__bg-wrap {
				position: absolute;
				inset: 0;
				z-index: 0;
				overflow: hidden;
				pointer-events: none;
			}

			.save-page__bg {
				position: absolute;
				inset: clamp(-2rem, -8vw, -4rem);
				z-index: 0;
				background:
					radial-gradient(ellipse 80% 60% at 18% 22%, #c9a87c 0%, transparent 52%),
					radial-gradient(ellipse 70% 55% at 82% 78%, #a67c52 0%, transparent 48%),
					radial-gradient(ellipse 55% 45% at 50% 50%, #8b6914 0%, transparent 42%),
					linear-gradient(155deg, #2a1810 0%, #4a3728 38%, #1c120b 100%);
				filter: blur(clamp(18px, 4vw, 36px)) saturate(1.15);
				transform: scale(1.08);
			}

			.save-page__veil {
				position: absolute;
				inset: 0;
				z-index: 1;
				background: rgba(28, 18, 11, 0.52);
				pointer-events: none;
			}

			.save-page__inner {
				position: relative;
				z-index: 2;
				width: 100%;
				max-width: 36rem;
				text-align: center;
			}

			.save-kicker {
				margin: 0 0 0.5rem;
				font-size: clamp(1.05rem, 2.8vw, 1.35rem);
				font-weight: 600;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: #e8d5b7;
			}

			.save-title {
				margin: 0 0 1rem;
				font-size: clamp(2.25rem, 7vw + 0.75rem, 3.75rem);
				font-weight: 800;
				line-height: 1.08;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				color: #fffcf7;
				text-shadow:
					0 0 20px rgba(255, 252, 247, 0.45),
					0 0 40px rgba(201, 168, 124, 0.35);
			}

			.save-teaser {
				margin: 0;
				font-size: clamp(0.95rem, 2.2vw, 1.1rem);
				line-height: 1.5;
				color: #d4c4a8;
			}

			.save-dates {
				list-style: none;
				margin: clamp(1rem, 3vw, 1.35rem) 0 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.65rem;
				font-size: clamp(0.9rem, 2.1vw, 1.05rem);
				line-height: 1.45;
				color: #e8dcc8;
			}

			.save-dates li {
				margin: 0;
			}

			.save-dates__kind {
				display: block;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #c9a87c;
				margin-bottom: 0.2rem;
			}

			.save-main {
				margin-top: clamp(2rem, 6vw, 3rem);
				display: flex;
				flex-direction: column;
				gap: clamp(1.35rem, 4vw, 2rem);
			}

			.save-rsvp {
				margin: 0;
				font-size: clamp(1rem, 2.5vw, 1.2rem);
				font-weight: 600;
				color: #e8c872;
				text-shadow: 0 0 18px rgba(232, 200, 114, 0.4);
			}

			.save-rsvp time {
				font-weight: 700;
			}

			.save-countdown {
				margin: 0 auto;
				padding: 1.15rem 1.25rem;
				max-width: 100%;
				border-radius: 1rem;
				background: rgba(45, 32, 22, 0.5);
				border: 1px solid rgba(232, 213, 183, 0.22);
				backdrop-filter: blur(10px);
			}

			.save-countdown__label {
				margin: 0 0 0.35rem;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: #c9a87c;
			}

			.save-countdown__date {
				margin: 0 0 0.5rem;
				font-size: 1rem;
				font-weight: 600;
				color: #f0e6d8;
			}

			.save-countdown__live {
				margin: 0;
				font-size: clamp(0.9rem, 2.2vw, 1rem);
				line-height: 1.45;
				color: #faf6ef;
				font-variant-numeric: tabular-nums;
			}

			.save-footnote {
				margin: 0;
				font-size: 0.9rem;
				color: #a89880;
			}
		</style>
	</body>
</html>
