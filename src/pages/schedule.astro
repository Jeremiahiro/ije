---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homePageContent, siteTitleSuffix } from "@/data/site-nav";

const title = `Schedule · ${siteTitleSuffix}`;
const description =
	"Ceremony schedule for Jane Onuoha and Jeremiah Iromaka, including event dates and venues in Abia State, Nigeria.";
const canonicalHref = new URL("/schedule", Astro.url.origin).href;
---

<BaseLayout title={title} description={description} canonicalHref={canonicalHref}>
	<main class="schedule-page wrapper" aria-labelledby="schedule-title">
		<header class="schedule-page__header">
			<p class="schedule-page__eyebrow">Schedule</p>
			<h1 id="schedule-title">Wedding Celebrations</h1>
		</header>

		<section class="schedule-page__events" aria-label="Event schedule">
			{
				homePageContent.events.map((event) => (
					<article class="schedule-event-card">
						<p class="schedule-event-card__date">{event.dateLabel}</p>
						<h2>{event.title}</h2>
						<p>{event.location}</p>
					</article>
				))
			}
		</section>
	</main>
</BaseLayout>

<style>
	.schedule-page {
		padding-top: clamp(6.75rem, 13vw, 10rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
		display: grid;
		gap: clamp(1.5rem, 4vw, 2.25rem);
	}

	.schedule-page__header {
		text-align: center;
	}

	.schedule-page__eyebrow {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: rgb(92 74 61 / 0.75);
	}

	.schedule-page__header h1 {
		margin: 0.85rem 0 0;
		font-size: clamp(2.1rem, 7vw, 4rem);
		line-height: 0.95;
		color: #3f2e22;
	}

	.schedule-page__events {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		max-width: min(100%, 64rem);
		margin-inline: auto;
		width: 100%;
	}

	.schedule-event-card {
		padding: 1.4rem 1.25rem 1.2rem;
		border: 1px solid rgb(110 82 60 / 0.16);
		border-radius: 1rem;
		background: rgb(255 252 247 / 0.55);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		text-align: center;
	}

	.schedule-event-card__date {
		margin: 0;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #6e523c;
	}

	.schedule-event-card h2 {
		margin: 0.6rem 0 0;
		font-size: 1.2rem;
		line-height: 1.35;
		color: #3a2e26;
	}

	.schedule-event-card p {
		margin: 0.75rem 0 0;
		font-size: 0.95rem;
		line-height: 1.7;
		color: rgb(58 46 38 / 0.88);
	}

	@media (min-width: 768px) {
		.schedule-page__events {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.4rem;
		}
	}
</style>
