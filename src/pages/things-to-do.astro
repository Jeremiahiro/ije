---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { thingsToDoRegions } from "@/data/things-to-do";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "Things to Do";
const title = `${pageTitle} · ${siteTitleSuffix}`;
const description =
  "A curated guide to places to visit in Lagos and Umuahia while celebrating with us.";
const canonicalHref = new URL("/things-to-do", Astro.url.origin).href;
---

<BaseLayout
  title={title}
  description={description}
  canonicalHref={canonicalHref}
>
  <main class="things-page wrapper" aria-labelledby="things-title">

    <header class="things-page__header" data-reveal>
      <p class="things-page__eyebrow">Explore</p>
      <h1 id="things-title">Things to Do</h1>
      <p class="things-page__lede">
        A curated selection of spots worth visiting in Lagos and Umuahia — whether you're arriving early or looking for an adventure between celebrations.
      </p>
    </header>

    <div class="things-page__regions">
      {
        thingsToDoRegions.map((section) => (
          <section
            class="things-page__region"
            id={section.id}
            aria-labelledby={`things-${section.id}-title`}
          >
            <div class="things-page__region-header" data-reveal>
              <h2
                id={`things-${section.id}-title`}
                class="things-page__region-title"
              >
                {section.region}
              </h2>
              <p class="things-page__region-note">{section.regionNote}</p>
            </div>

            <div class="things-page__grid">
              {section.items.map((item, itemIndex) => (
                <article
                  class="things-item"
                  data-reveal
                  data-delay={String(itemIndex + 1)}
                >
                  <div class="things-item__top">
                    <span class="things-item__tag">{item.tag}</span>
                    <h3 class="things-item__title">{item.title}</h3>
                    <p class="things-item__description">{item.description}</p>
                  </div>
                  <div class="things-item__bottom">
                    <p class="things-item__location">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M6 1C4.07 1 2.5 2.57 2.5 4.5 2.5 7.25 6 11 6 11s3.5-3.75 3.5-6.5C9.5 2.57 7.93 1 6 1zm0 4.75a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z" fill="currentColor"/>
                      </svg>
                      {item.location}
                    </p>
                    {item.mapHref && (
                      <a
                        class="things-item__map-link"
                        href={item.mapHref}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        View on map
                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
                          <path d="M2 9L9 2M9 2H4.5M9 2v4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .things-page {
    padding-top: clamp(6.75rem, 13vw, 9.5rem);
    padding-bottom: clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
  }

  /* Header */

  .things-page__header {
    text-align: center;
    max-width: 52rem;
    margin-inline: auto;
  }

  .things-page__eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(92 74 61 / 0.75);
  }

  .things-page__header h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1;
    color: #3f2e22;
  }

  .things-page__lede {
    margin: 0;
    max-width: 48ch;
    margin-inline: auto;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    line-height: 1.82;
    color: rgb(58 46 38 / 0.82);
  }

  /* Regions */

  .things-page__regions {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .things-page__region {
    display: grid;
    gap: 1.75rem;
  }

  .things-page__region-header {
    text-align: center;
  }

  .things-page__region-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    color: #3a2e26;
  }

  .things-page__region-note {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.72;
    color: rgb(58 46 38 / 0.75);
    max-width: 60ch;
    margin-inline: auto;
  }

  /* Grid */

  .things-page__grid {
    display: grid;
    gap: 1.1rem;
  }

  @media (min-width: 640px) {
    .things-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  /* Item cards */

  .things-item {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.35rem, 3vw, 1.75rem);
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 1.5rem;
    background: rgb(255 255 255 / 0.4);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 14px 40px rgb(110 82 60 / 0.09);
    transition:
      transform 220ms ease,
      box-shadow 220ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .things-item:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 52px rgb(110 82 60 / 0.16);
    }
  }

  .things-item__top {
    flex: 1;
    display: grid;
    gap: 0.55rem;
  }

  .things-item__tag {
    display: inline-block;
    justify-self: start;
    padding: 0.22rem 0.7rem;
    border-radius: 9999px;
    border: 1px solid rgb(110 82 60 / 0.2);
    background: rgb(110 82 60 / 0.07);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5c4a3d;
  }

  .things-item__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 400;
    line-height: 1.1;
    color: #3a2e26;
  }

  .things-item__description {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.72;
    color: rgb(58 46 38 / 0.8);
  }

  /* Bottom row */

  .things-item__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding-top: 1rem;
    border-top: 1px solid rgb(110 82 60 / 0.12);
  }

  .things-item__location {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: rgb(92 74 61 / 0.65);
    flex: 1;
  }

  .things-item__location svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
    color: rgb(110 82 60 / 0.5);
  }

  .things-item__map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    border: 1px solid rgb(110 82 60 / 0.22);
    background: transparent;
    color: #6e523c;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .things-item__map-link:hover {
      background: #6e523c;
      border-color: #6e523c;
      color: #fff;
      transform: translateY(-1px);
    }
  }
</style>
