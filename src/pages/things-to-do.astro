---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "Things to Do";
const title = `${pageTitle} · ${siteTitleSuffix}`;
const description =
	"A curated list of places to visit in Lagos and Umuahia.";
const canonicalHref = new URL("/things-to-do", Astro.url.origin).href;

const listItems = [
	{
		title: "Nike Art Gallery",
		location: "2 Nike Art Gallery Road, Lekki, Lagos, Nigeria",
	},
	{
		title: "Lekki Conservation Centre",
		location: "Km 19 Lekki - Epe Expressway, Lekki, Lagos, Nigeria",
	},
	{
		title: "De Latinos Lounge, Bar & Events Center",
		location: "BCA Road, Umuahia, Abia State, Nigeria",
	},
	{
		title: "National War Museum, Umuahia",
		location: "Road, Umuahia, Abia State, Nigeria",
	},
];
---

<BaseLayout title={title} description={description} canonicalHref={canonicalHref}>
	<main class="things-page wrapper" aria-labelledby="things-title">
		<header class="things-page__header">
			<h1 id="things-title">Things to Do</h1>
		</header>

		<section class="things-page__list" aria-label="Wedding location list">
			{
				listItems.map((item) => (
					<article class="things-item">
						<h2>{item.title}</h2>
						<p class="things-item__location">{item.location}</p>
					</article>
				))
			}
		</section>
	</main>
</BaseLayout>

<style>
	.things-page {
		padding-top: clamp(6.75rem, 13vw, 9.5rem);
		padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
		display: grid;
		gap: clamp(1.5rem, 4vw, 2.3rem);
	}

	.things-page__header {
		text-align: center;
		margin-inline: auto;
	}

	.things-page__header h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 3.3rem);
		line-height: 1;
		color: #3f2e22;
	}

	.things-page__list {
		display: grid;
		gap: 0.95rem;
		max-width: 44rem;
		width: 100%;
		margin-inline: auto;
	}

	.things-item {
		border: 1px solid rgb(110 82 60 / 0.18);
		border-radius: 1rem;
		padding: clamp(1rem, 2.8vw, 1.4rem);
		background: rgb(255 252 247 / 0.55);
		text-align: center;
	}

	.things-item h2 {
		margin: 0;
		font-size: clamp(1.65rem, 4.4vw, 2.2rem);
		line-height: 1.05;
		color: #3a2e26;
	}

	.things-item__location {
		margin: 0.85rem 0 0;
		font-size: 0.95rem;
		line-height: 1.68;
		color: rgb(58 46 38 / 0.9);
	}
</style>
