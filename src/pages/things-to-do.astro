---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { thingsToDoRegions } from "@/data/things-to-do";
import { siteTitleSuffix } from "@/data/site-nav";

const pageTitle = "Things to Do";
const title = `${pageTitle} · ${siteTitleSuffix}`;
const description = "A curated list of places to visit in Lagos and Umuahia.";
const canonicalHref = new URL("/things-to-do", Astro.url.origin).href;
---

<BaseLayout
  title={title}
  description={description}
  canonicalHref={canonicalHref}
>
  <main class="things-page wrapper" aria-labelledby="things-title">
    <header class="things-page__header">
      <h1 id="things-title">Things to Do</h1>
    </header>

    <div class="things-page__regions">
      {
        thingsToDoRegions.map((section) => (
          <section
            class="things-page__region"
            id={section.id}
            aria-labelledby={`things-${section.id}-title`}
          >
            <h2
              id={`things-${section.id}-title`}
              class="things-page__region-title"
            >
              {section.region}
            </h2>
            <div
              class="things-page__list"
              aria-label={`Places in ${section.region}`}
            >
              {section.items.map((item) => (
                <article class="things-item">
                  <h3>{item.title}</h3>
                  <p class="things-item__location">{item.location}</p>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  .things-page {
    padding-top: clamp(6.75rem, 13vw, 9.5rem);
    padding-bottom: clamp(2.75rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.3rem);
  }

  .things-page__header {
    text-align: center;
    margin-inline: auto;
  }

  .things-page__header h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.3rem);
    line-height: 1;
    color: #3f2e22;
  }

  .things-page__regions {
    display: grid;
    gap: clamp(2rem, 5vw, 2.75rem);
    max-width: 44rem;
    width: 100%;
    margin-inline: auto;
  }

  .things-page__region {
    display: grid;
    gap: 1.25rem;
    width: 100%;
    justify-items: center;
    position: relative;
  }

  .things-page__region:not(:first-child) {
    padding-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  .things-page__region:not(:first-child)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(100%, 22rem);
    height: 1px;
    background: linear-gradient(
      to right,
      rgb(110 82 60 / 0),
      rgb(110 82 60 / 0.35),
      rgb(110 82 60 / 0)
    );
  }

  .things-page__region-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.05;
    color: #3a2e26;
    text-align: center;
  }

  .things-page__list {
    display: grid;
    gap: 0.95rem;
    width: 100%;
  }

  .things-item {
    border: 1px solid rgb(110 82 60 / 0.18);
    border-radius: 1rem;
    padding: clamp(1rem, 2.8vw, 1.4rem);
    background: rgb(255 252 247 / 0.55);
    text-align: center;
  }

  .things-item h3 {
    margin: 0;
    font-size: clamp(1.65rem, 4.4vw, 2.2rem);
    line-height: 1.05;
    color: #3a2e26;
  }

  .things-item__location {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    line-height: 1.68;
    color: rgb(58 46 38 / 0.9);
  }
</style>
